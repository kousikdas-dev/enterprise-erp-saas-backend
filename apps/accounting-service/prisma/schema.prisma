generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Domain models are added incrementally. This service owns accounting_db only.
// Planned next: FiscalPeriod, TrialBalance snapshots, Tax Master.
// This service never reads sales_db, purchase_db or inventory_db directly.

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  VOID
}

model Account {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @db.Uuid
  code        String
  name        String
  type        AccountType
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  parentId String?  @db.Uuid
  parent   Account? @relation("AccountHierarchy", fields: [parentId], references: [id])
  children Account[] @relation("AccountHierarchy")
  lines    JournalLine[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, parentId])
  @@map("accounts")
}

model JournalEntry {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @db.Uuid
  entryNumber String
  entryDate   DateTime
  description String?
  status      JournalEntryStatus @default(DRAFT)
  postedAt    DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  lines JournalLine[]

  @@unique([tenantId, entryNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, entryDate])
  @@map("journal_entries")
}

model JournalLine {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  journalEntryId String   @db.Uuid
  lineNumber     Int
  accountId      String   @db.Uuid
  debitAmount    Decimal  @default(0) @db.Decimal(19, 4)
  creditAmount   Decimal  @default(0) @db.Decimal(19, 4)
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_lines")
}
