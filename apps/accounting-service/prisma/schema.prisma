generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Domain models are added incrementally. This service owns accounting_db only.
// Planned next: FiscalPeriod, TrialBalance snapshots.
// This service never reads sales_db, purchase_db or inventory_db directly.

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  VOID
}

enum TaxComponentType {
  CGST
  SGST
  IGST
  CESS
  OTHER
}

// Phase C1 (Accounting Foundation) — generic, tenant-scoped "business role ->
// GL account" resolution, used by the internal journal-postings API so that
// callers (Purchase, later Sales) never need to know a real Account id.
// PURCHASE_EXPENSE/ACCOUNTS_PAYABLE/INPUT_TAX/SALES_REVENUE/
// ACCOUNTS_RECEIVABLE/OUTPUT_TAX/SALES_DISCOUNT/INVENTORY_ASSET/COGS/
// GOODS_RECEIVED_NOT_INVOICED/PURCHASE_PRICE_VARIANCE/OPENING_BALANCE_EQUITY
// are tenant-wide singletons (externalRefId always ""); PAYMENT_METHOD is
// per-entity (externalRefId = a master-data PaymentMethod id) and shared by
// both Purchase and Sales — one mapping per PaymentMethod regardless of
// which side posts against it. No fallback tier exists for any purpose —
// an unmapped purpose/externalRefId always fails posting rather than
// guessing an account (approved design, Phase C1/C2 review; Sales purposes
// added under the same design in the Sales Accounting Integration phase).
// SALES_DISCOUNT is a contra-revenue purpose: the mapped Account is expected
// to be AccountType.REVENUE, debited (rather than credited) when posted —
// there is no separate CONTRA_REVENUE AccountType; the debit-normal usage is
// purely a convention of how this purpose is posted, not a schema-level
// distinction.
// INVENTORY_ASSET/COGS/GOODS_RECEIVED_NOT_INVOICED/PURCHASE_PRICE_VARIANCE/
// OPENING_BALANCE_EQUITY are added in this phase (Inventory Valuation +
// Inventory Accounting V1 design review) as semantic roles only — no
// resolution logic, posting logic, or seed data accompanies them yet; they
// integrate with the existing AccountMapping resolution mechanism exactly
// like every other purpose above and are configured the same way (via the
// existing Account Mappings UI/API), one mapping per tenant.
enum AccountMappingPurpose {
  PURCHASE_EXPENSE
  ACCOUNTS_PAYABLE
  INPUT_TAX
  PAYMENT_METHOD
  SALES_REVENUE
  ACCOUNTS_RECEIVABLE
  OUTPUT_TAX
  SALES_DISCOUNT
  INVENTORY_ASSET
  COGS
  GOODS_RECEIVED_NOT_INVOICED
  PURCHASE_PRICE_VARIANCE
  OPENING_BALANCE_EQUITY
}

model Account {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @db.Uuid
  code        String
  name        String
  type        AccountType
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  parentId String?  @db.Uuid
  parent   Account? @relation("AccountHierarchy", fields: [parentId], references: [id])
  children Account[] @relation("AccountHierarchy")
  lines    JournalLine[]
  taxComponents TaxComponent[]
  accountMappings AccountMapping[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, parentId])
  @@map("accounts")
}

model AccountMapping {
  id            String                @id @default(uuid()) @db.Uuid
  tenantId      String                @db.Uuid
  purpose       AccountMappingPurpose
  // "" for the tenant-wide singleton purposes; a foreign entity id (e.g. a
  // PaymentMethod id) for PAYMENT_METHOD — always non-null so one unique
  // index correctly enforces both "one singleton per tenant/purpose" and
  // "one mapping per tenant/purpose/entity" (Postgres null-distinctness
  // would otherwise let multiple singleton rows coexist).
  externalRefId String                @default("")
  accountId     String                @db.Uuid
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([tenantId, purpose, externalRefId])
  @@index([tenantId])
  @@map("account_mappings")
}

model JournalEntry {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @db.Uuid
  entryNumber String
  entryDate   DateTime
  description String?
  status      JournalEntryStatus @default(DRAFT)
  postedAt    DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  // Phase C1 — links a machine-posted entry back to its originating document
  // for idempotency (@@unique below) and traceability. NULL on every entry
  // created through the pre-existing manual create()/post() flow (Postgres
  // treats each NULL tuple as distinct, so manual entries never collide with
  // each other or with source-linked ones). A reversal entry gets its OWN
  // distinct source reference (its sourceType differs from the original's,
  // e.g. "*_CANCELLATION") — the original entry this reverses is instead
  // named via reversesJournalEntryId, and the original is NEVER mutated:
  // it stays POSTED permanently (approved Phase C1/C2 review — no VOID).
  sourceService String?
  sourceType    String?
  sourceId      String?

  reversesJournalEntryId String?        @db.Uuid
  reversesJournalEntry   JournalEntry?  @relation("JournalEntryReversal", fields: [reversesJournalEntryId], references: [id])
  reversedBy             JournalEntry[] @relation("JournalEntryReversal")

  lines JournalLine[]

  @@unique([tenantId, entryNumber])
  @@unique([tenantId, sourceService, sourceType, sourceId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, entryDate])
  // Covers the Account Ledger query's WHERE (tenantId, status='POSTED',
  // entryDate range) in a single index scan instead of a bitmap AND of the
  // two separate indexes above.
  @@index([tenantId, status, entryDate])
  @@map("journal_entries")
}

model JournalLine {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  journalEntryId String   @db.Uuid
  lineNumber     Int
  accountId      String   @db.Uuid
  debitAmount    Decimal  @default(0) @db.Decimal(19, 4)
  creditAmount   Decimal  @default(0) @db.Decimal(19, 4)
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([journalEntryId])
  @@index([accountId])
  // Covers the Account Ledger query's WHERE (tenantId, accountId) — the
  // primary access pattern for "all lines for one account" before joining
  // to journal_entries for the status/date filter.
  @@index([tenantId, accountId])
  @@map("journal_lines")
}

model TaxCode {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  code        String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  components TaxComponent[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("tax_codes")
}

model TaxComponent {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @db.Uuid
  taxCodeId String           @db.Uuid
  sequence  Int
  type      TaxComponentType
  name      String?
  rate      Decimal          @db.Decimal(7, 4)
  accountId String?          @db.Uuid
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  taxCode TaxCode  @relation(fields: [taxCodeId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([taxCodeId, sequence])
  @@index([tenantId])
  @@index([taxCodeId])
  @@map("tax_components")
}
