generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum ProformaSourceType {
  QUOTATION
  SALES_ORDER
}

enum ProformaInvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

enum ShipmentStatus {
  PENDING_STOCK
  POSTED
}

enum CustomerAddressType {
  BILLING
  SHIPPING
}

enum SalesInvoiceSourceType {
  SALES_ORDER
  PROFORMA_INVOICE
}

enum SalesInvoiceStatus {
  DRAFT
  SENT
  CANCELLED
}

enum SalesInvoicePaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

model Customer {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  code     String
  name     String

  // Basic Information
  company     String?
  email       String?
  phone       String?
  jobPosition String?
  website     String?
  tags        String[] @default([])
  gstin       String?

  // Sales
  salespersonId    String? @db.Uuid
  paymentTermId    String? @db.Uuid
  paymentMethodId  String? @db.Uuid
  fiscalPositionId String? @db.Uuid
  industryId       String? @db.Uuid

  // Main Address
  street  String?
  street2 String?
  city    String?
  zip     String?
  state   String?
  country String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotations    Quotation[]
  salesOrders   SalesOrder[]
  salesInvoices SalesInvoice[]
  addresses     CustomerAddress[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, salespersonId])
  @@index([tenantId, paymentTermId])
  @@index([tenantId, paymentMethodId])
  @@index([tenantId, fiscalPositionId])
  @@index([tenantId, industryId])
  @@map("customers")
}

model CustomerAddress {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId     String              @db.Uuid
  customerId   String              @db.Uuid
  type         CustomerAddressType
  name         String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  postalCode   String?
  country      String
  phone        String?
  isDefault    Boolean             @default(false)
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
  @@index([tenantId, customerId, type])
  @@map("customer_addresses")
}

model Quotation {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @db.Uuid
  customerId      String          @db.Uuid
  status          QuotationStatus @default(DRAFT)
  customerName    String
  billingAddress  String?
  shippingAddress String?
  notes           String?
  paymentTermId   String?         @db.Uuid
  salespersonId   String?         @db.Uuid
  deliveryDate    DateTime?
  subtotal        Decimal         @db.Decimal(19, 4)
  discountTotal   Decimal         @default(0) @db.Decimal(19, 4)
  taxTotal        Decimal         @default(0) @db.Decimal(19, 4)
  total           Decimal         @db.Decimal(19, 4)
  validUntil      DateTime?
  sentAt          DateTime?
  acceptedAt      DateTime?
  rejectedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items      QuotationItem[]
  salesOrder SalesOrder?

  @@index([tenantId])
  @@index([customerId])
  @@index([tenantId, status])
  @@index([tenantId, paymentTermId])
  @@index([tenantId, salespersonId])
  @@map("quotations")
}

model QuotationItem {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  quotationId      String   @db.Uuid
  productId        String   @db.Uuid
  productSku       String
  productName      String
  quantity         Decimal  @db.Decimal(19, 6)
  unitOfMeasureId  String?  @db.Uuid
  uomCode          String?
  uomName          String?
  conversionFactor Decimal? @db.Decimal(19, 6)
  unitPrice        Decimal  @db.Decimal(19, 4)
  discountPercent  Decimal  @default(0) @db.Decimal(5, 2)
  discountAmount   Decimal  @default(0) @db.Decimal(19, 4)
  taxCodeId        String?  @db.Uuid
  taxCode          String?
  taxCodeName      String?
  taxAmount        Decimal  @default(0) @db.Decimal(19, 4)
  lineSubtotal     Decimal  @db.Decimal(19, 4)
  lineTotal        Decimal  @db.Decimal(19, 4)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  quotation     Quotation                   @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  taxComponents QuotationItemTaxComponent[]

  @@index([tenantId])
  @@index([quotationId])
  @@index([productId])
  @@index([tenantId, unitOfMeasureId])
  @@index([tenantId, taxCodeId])
  @@map("quotation_items")
}

model QuotationItemTaxComponent {
  id                 String  @id @default(uuid()) @db.Uuid
  tenantId           String  @db.Uuid
  quotationItemId    String  @db.Uuid
  sequence           Int
  type               String
  name               String?
  rate               Decimal @db.Decimal(7, 4)
  componentTaxAmount Decimal @db.Decimal(19, 4)

  quotationItem QuotationItem @relation(fields: [quotationItemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([quotationItemId])
  @@map("quotation_item_tax_components")
}

model ProformaInvoice {
  id              String                @id @default(uuid()) @db.Uuid
  tenantId        String                @db.Uuid
  documentNumber  String
  sourceType      ProformaSourceType
  sourceId        String                @db.Uuid
  status          ProformaInvoiceStatus @default(DRAFT)
  customerId      String                @db.Uuid
  customerName    String
  billingAddress  String?
  shippingAddress String?
  notes           String?
  subtotal        Decimal               @db.Decimal(19, 4)
  discountTotal   Decimal               @default(0) @db.Decimal(19, 4)
  taxTotal        Decimal               @default(0) @db.Decimal(19, 4)
  total           Decimal               @db.Decimal(19, 4)
  issuedAt        DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  items ProformaInvoiceItem[]

  @@unique([tenantId, documentNumber])
  @@index([tenantId])
  @@index([tenantId, sourceType, sourceId])
  @@index([tenantId, status])
  @@map("proforma_invoices")
}

model ProformaInvoiceItem {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  proformaInvoiceId String   @db.Uuid
  productId         String   @db.Uuid
  productSku        String
  productName       String
  quantity          Decimal  @db.Decimal(19, 6)
  unitOfMeasureId   String?  @db.Uuid
  uomCode           String?
  uomName           String?
  conversionFactor  Decimal? @db.Decimal(19, 6)
  unitPrice         Decimal  @db.Decimal(19, 4)
  discountPercent   Decimal  @default(0) @db.Decimal(5, 2)
  discountAmount    Decimal  @default(0) @db.Decimal(19, 4)
  taxCodeId         String?  @db.Uuid
  taxCode           String?
  taxCodeName       String?
  taxAmount         Decimal  @default(0) @db.Decimal(19, 4)
  lineSubtotal      Decimal  @db.Decimal(19, 4)
  lineTotal         Decimal  @db.Decimal(19, 4)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  proformaInvoice ProformaInvoice                   @relation(fields: [proformaInvoiceId], references: [id], onDelete: Cascade)
  taxComponents   ProformaInvoiceItemTaxComponent[]

  @@index([tenantId])
  @@index([proformaInvoiceId])
  @@index([productId])
  @@index([tenantId, unitOfMeasureId])
  @@index([tenantId, taxCodeId])
  @@map("proforma_invoice_items")
}

model ProformaInvoiceItemTaxComponent {
  id                    String  @id @default(uuid()) @db.Uuid
  tenantId              String  @db.Uuid
  proformaInvoiceItemId String  @db.Uuid
  sequence              Int
  type                  String
  name                  String?
  rate                  Decimal @db.Decimal(7, 4)
  componentTaxAmount    Decimal @db.Decimal(19, 4)

  proformaInvoiceItem ProformaInvoiceItem @relation(fields: [proformaInvoiceItemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([proformaInvoiceItemId])
  @@map("proforma_invoice_item_tax_components")
}

model SalesOrder {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @db.Uuid
  customerId      String           @db.Uuid
  quotationId     String?          @unique @db.Uuid
  status          SalesOrderStatus @default(DRAFT)
  customerName    String
  billingAddress  String?
  shippingAddress String?
  notes           String?
  subtotal        Decimal          @db.Decimal(19, 4)
  discountTotal   Decimal          @default(0) @db.Decimal(19, 4)
  taxTotal        Decimal          @default(0) @db.Decimal(19, 4)
  total           Decimal          @db.Decimal(19, 4)
  confirmedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  customer  Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotation Quotation?       @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  items     SalesOrderItem[]
  shipments Shipment[]

  @@index([tenantId])
  @@index([customerId])
  @@index([tenantId, status])
  @@map("sales_orders")
}

model SalesOrderItem {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  salesOrderId     String   @db.Uuid
  productId        String   @db.Uuid
  productSku       String
  productName      String
  quantity         Decimal  @db.Decimal(19, 6)
  unitOfMeasureId  String?  @db.Uuid
  uomCode          String?
  uomName          String?
  conversionFactor Decimal? @db.Decimal(19, 6)
  unitPrice        Decimal  @db.Decimal(19, 4)
  discountPercent  Decimal  @default(0) @db.Decimal(5, 2)
  discountAmount   Decimal  @default(0) @db.Decimal(19, 4)
  taxCodeId        String?  @db.Uuid
  taxCode          String?
  taxCodeName      String?
  taxAmount        Decimal  @default(0) @db.Decimal(19, 4)
  lineSubtotal     Decimal  @db.Decimal(19, 4)
  lineTotal        Decimal  @db.Decimal(19, 4)
  shippedQuantity  Decimal  @default(0) @db.Decimal(19, 6)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  salesOrder    SalesOrder                   @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  shipmentItems ShipmentItem[]
  taxComponents SalesOrderItemTaxComponent[]

  @@index([tenantId])
  @@index([salesOrderId])
  @@index([productId])
  @@index([tenantId, unitOfMeasureId])
  @@index([tenantId, taxCodeId])
  @@map("sales_order_items")
}

model SalesOrderItemTaxComponent {
  id                 String  @id @default(uuid()) @db.Uuid
  tenantId           String  @db.Uuid
  salesOrderItemId   String  @db.Uuid
  sequence           Int
  type               String
  name               String?
  rate               Decimal @db.Decimal(7, 4)
  componentTaxAmount Decimal @db.Decimal(19, 4)

  salesOrderItem SalesOrderItem @relation(fields: [salesOrderItemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([salesOrderItemId])
  @@map("sales_order_item_tax_components")
}

model Shipment {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @db.Uuid
  salesOrderId String         @db.Uuid
  warehouseId  String         @db.Uuid
  status       ShipmentStatus @default(PENDING_STOCK)
  shippedAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  salesOrder SalesOrder     @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  items      ShipmentItem[]

  @@index([tenantId])
  @@index([salesOrderId])
  @@index([tenantId, status])
  @@map("shipments")
}

model ShipmentItem {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  shipmentId       String   @db.Uuid
  salesOrderItemId String   @db.Uuid
  productId        String   @db.Uuid
  productSku       String
  productName      String
  quantity         Decimal  @db.Decimal(19, 6)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  shipment       Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  salesOrderItem SalesOrderItem @relation(fields: [salesOrderItemId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([shipmentId])
  @@index([salesOrderItemId])
  @@index([productId])
  @@map("shipment_items")
}

model SalesInvoice {
  id              String                    @id @default(uuid()) @db.Uuid
  tenantId        String                    @db.Uuid
  invoiceNumber   String
  sourceType      SalesInvoiceSourceType?
  sourceId        String?                   @db.Uuid
  status          SalesInvoiceStatus        @default(DRAFT)
  customerId      String                    @db.Uuid
  customerName    String
  billingAddress  String?
  shippingAddress String?
  // Master-data/identity UUIDs intentionally have no foreign keys: that data
  // belongs to separate services/databases (mirrors Customer.paymentTermId /
  // Customer.salespersonId).
  paymentTermId   String?                   @db.Uuid
  salespersonId   String?                   @db.Uuid
  invoiceDate     DateTime
  dueDate         DateTime?
  notes           String?
  subtotal        Decimal                   @db.Decimal(19, 4)
  discountTotal   Decimal                   @default(0) @db.Decimal(19, 4)
  taxTotal        Decimal                   @default(0) @db.Decimal(19, 4)
  total           Decimal                   @db.Decimal(19, 4)
  // balanceDue is intentionally not persisted: it is always total - amountPaid.
  amountPaid      Decimal                   @default(0) @db.Decimal(19, 4)
  paymentStatus   SalesInvoicePaymentStatus @default(UNPAID)
  sentAt          DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  customer Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items    SalesInvoiceItem[]
  payments SalesPayment[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([customerId])
  @@index([tenantId, status])
  @@index([tenantId, sourceType, sourceId])
  @@index([tenantId, paymentTermId])
  @@index([tenantId, salespersonId])
  @@map("sales_invoices")
}

model SalesInvoiceItem {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  salesInvoiceId   String   @db.Uuid
  productId        String   @db.Uuid
  productSku       String
  productName      String
  quantity         Decimal  @db.Decimal(19, 6)
  unitOfMeasureId  String?  @db.Uuid
  uomCode          String?
  uomName          String?
  conversionFactor Decimal? @db.Decimal(19, 6)
  unitPrice        Decimal  @db.Decimal(19, 4)
  discountPercent  Decimal  @default(0) @db.Decimal(5, 2)
  discountAmount   Decimal  @default(0) @db.Decimal(19, 4)
  taxCodeId        String?  @db.Uuid
  taxCode          String?
  taxCodeName      String?
  taxAmount        Decimal  @default(0) @db.Decimal(19, 4)
  lineSubtotal     Decimal  @db.Decimal(19, 4)
  lineTotal        Decimal  @db.Decimal(19, 4)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  salesInvoice  SalesInvoice                   @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  taxComponents SalesInvoiceItemTaxComponent[]

  @@index([tenantId])
  @@index([salesInvoiceId])
  @@index([productId])
  @@index([tenantId, unitOfMeasureId])
  @@index([tenantId, taxCodeId])
  @@map("sales_invoice_items")
}

model SalesInvoiceItemTaxComponent {
  id                 String  @id @default(uuid()) @db.Uuid
  tenantId           String  @db.Uuid
  salesInvoiceItemId String  @db.Uuid
  sequence           Int
  type               String
  name               String?
  rate               Decimal @db.Decimal(7, 4)
  componentTaxAmount Decimal @db.Decimal(19, 4)

  salesInvoiceItem SalesInvoiceItem @relation(fields: [salesInvoiceItemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([salesInvoiceItemId])
  @@map("sales_invoice_item_tax_components")
}

model SalesPayment {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  salesInvoiceId  String   @db.Uuid
  amount          Decimal  @db.Decimal(19, 4)
  paymentDate     DateTime
  // Master-data UUID intentionally has no foreign key: that data belongs to
  // a separate service/database (mirrors SalesInvoice.paymentTermId).
  paymentMethodId String?  @db.Uuid
  reference       String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  salesInvoice SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([salesInvoiceId])
  @@map("sales_payments")
}
