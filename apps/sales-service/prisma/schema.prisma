generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Domain models are added incrementally. This service owns sales_db only.
// Planned: Customer snapshot refs, SalesOrder, SalesInvoice.
// Accounting postings are emitted as events; this service never writes to accounting_db.

/// Infrastructure-only marker so Prisma Client can be generated before domain models exist.
/// Not a business entity. Do not expose via API.
model SchemaMeta {
  id        String   @id @default("foundation")
  appliedAt DateTime @default(now())

  @@map("_schema_meta")
}
