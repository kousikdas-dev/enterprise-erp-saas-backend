generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum ProformaSourceType {
  QUOTATION
  SALES_ORDER
}

enum ProformaInvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

// UOM_RESOLUTION_REQUIRED is reachable only from PENDING_STOCK, only for
// pre-fix legacy ShipmentItem rows whose historical UOM/conversionFactor
// cannot be safely recovered from their SalesOrderItem (Inventory Design v4,
// Sales Shipment UOM Phase A, §5-C). It is never reachable for a shipment
// created after this migration — those always carry a persisted
// baseQuantity from creation. Leaving it requires an explicit manual
// resolution (see ShipmentItem.conversionResolvedBy/At/Note below), never an
// automatic default.
enum ShipmentStatus {
  PENDING_STOCK
  POSTED
  UOM_RESOLUTION_REQUIRED
  // Phase 3.16 (Shipment Cancellation / COGS Reversal) — undoes a POSTED
  // shipment's effects on Inventory, COGS accounting, and
  // SalesOrderItem.shippedQuantity / SalesOrder.status. Full-shipment-only
  // (never partial), and only when zero downstream activity exists (no
  // Sales Return recorded against any line) — see ShipmentsService.reverse()'s
  // own doc comment. Mirrors GoodsReceiptStatus.REVERSED (Phase 3.7) exactly.
  REVERSED
}

// Phase 3.3 (Sales Shipment COGS) / Phase 3.16 (Shipment Cancellation) —
// Shipment posting mirrors GoodsReceiptPostingStatus's exact four-value
// shape (Shipment DOES have a reversal lifecycle, as of Phase 3.16). No
// third "reversal failed" value: a failed reversal attempt deliberately
// leaves this at POSTED, exactly like every other reversal in this codebase
// — retryAccountingReversal() is the dedicated recovery path.
enum ShipmentPostingStatus {
  NOT_POSTED
  POSTED
  FAILED
  REVERSED
}

enum CustomerAddressType {
  BILLING
  SHIPPING
}

enum SalesInvoiceSourceType {
  SALES_ORDER
  PROFORMA_INVOICE
}

enum SalesInvoiceStatus {
  DRAFT
  SENT
  CANCELLED
}

enum SalesInvoicePaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

// Sales Accounting Integration — Sales-side cache of accounting-service's
// own posting state (mirrors PurchaseInvoicePostingStatus /
// SupplierPaymentPostingStatus exactly). No fallback account exists for any
// purpose, so a posting attempt can legitimately sit at FAILED until
// retried via retryAccountingPosting()/retryAccountingReversal().
enum SalesInvoicePostingStatus {
  NOT_POSTED
  POSTED
  FAILED
  REVERSED
}

enum SalesPaymentPostingStatus {
  NOT_POSTED
  POSTED
  FAILED
  REVERSED
}

// Document-level lifecycle (Phase 3.11) — separate from
// SalesPaymentPostingStatus above, mirrors SupplierPaymentStatus exactly.
enum SalesPaymentStatus {
  ACTIVE
  REVERSED
}

// Phase 3.12 (Sales Return / Credit Note) — mirrors PurchaseReturnStatus
// exactly. DRAFT is freely editable; CONFIRMED posts accounting + inventory
// and locks the lines; REVERSED undoes a CONFIRMED return's effects (never
// CANCELLED — mirrors Purchase Return's own vocabulary for "undo a posted
// inventory/accounting-affecting document").
enum SalesReturnStatus {
  DRAFT
  CONFIRMED
  REVERSED
}

enum SalesReturnPostingStatus {
  NOT_POSTED
  POSTED
  FAILED
  REVERSED
}

model Customer {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  code     String
  name     String

  // Basic Information
  company     String?
  email       String?
  phone       String?
  jobPosition String?
  website     String?
  tags        String[] @default([])
  gstin       String?

  // Sales
  salespersonId    String? @db.Uuid
  paymentTermId    String? @db.Uuid
  paymentMethodId  String? @db.Uuid
  fiscalPositionId String? @db.Uuid
  industryId       String? @db.Uuid

  // Main Address
  street  String?
  street2 String?
  city    String?
  zip     String?
  state   String?
  country String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotations       Quotation[]
  salesOrders      SalesOrder[]
  salesInvoices    SalesInvoice[]
  addresses        CustomerAddress[]
  // Phase 3.14 (Standalone Sales Credit Note) — a Credit Note is always tied
  // to a Customer, never optional, unlike its optional SalesInvoice reference.
  salesCreditNotes SalesCreditNote[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, salespersonId])
  @@index([tenantId, paymentTermId])
  @@index([tenantId, paymentMethodId])
  @@index([tenantId, fiscalPositionId])
  @@index([tenantId, industryId])
  @@map("customers")
}

model CustomerAddress {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId     String              @db.Uuid
  customerId   String              @db.Uuid
  type         CustomerAddressType
  name         String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  postalCode   String?
  country      String
  phone        String?
  isDefault    Boolean             @default(false)
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
  @@index([tenantId, customerId, type])
  @@map("customer_addresses")
}

model Quotation {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @db.Uuid
  customerId      String          @db.Uuid
  status          QuotationStatus @default(DRAFT)
  customerName    String
  billingAddress  String?
  shippingAddress String?
  notes           String?
  paymentTermId   String?         @db.Uuid
  salespersonId   String?         @db.Uuid
  deliveryDate    DateTime?
  subtotal        Decimal         @db.Decimal(19, 4)
  discountTotal   Decimal         @default(0) @db.Decimal(19, 4)
  taxTotal        Decimal         @default(0) @db.Decimal(19, 4)
  total           Decimal         @db.Decimal(19, 4)
  validUntil      DateTime?
  sentAt          DateTime?
  acceptedAt      DateTime?
  rejectedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items      QuotationItem[]
  salesOrder SalesOrder?

  @@index([tenantId])
  @@index([customerId])
  @@index([tenantId, status])
  @@index([tenantId, paymentTermId])
  @@index([tenantId, salespersonId])
  @@map("quotations")
}

model QuotationItem {
  id                     String   @id @default(uuid()) @db.Uuid
  tenantId               String   @db.Uuid
  quotationId            String   @db.Uuid
  productId              String   @db.Uuid
  productSku             String
  productName            String
  quantity               Decimal  @db.Decimal(19, 6)
  unitOfMeasureId        String?  @db.Uuid
  uomCode                String?
  uomName                String?
  conversionFactor       Decimal? @db.Decimal(19, 6)
  // Phase 3.3 (Sales Shipment COGS) — snapshotted verbatim from
  // inventory-service's Product.trackInventory via the same getUomOptions()
  // round-trip already used for UOM resolution — no separate call. Copied
  // forward to SalesOrderItem when a Sales Order is converted from this
  // Quotation, never re-fetched. Nullable permanently, not just during a
  // migration window: every row created before this column existed has NULL
  // here, and NULL is always treated identically to false downstream.
  productTracksInventory Boolean?
  unitPrice              Decimal  @db.Decimal(19, 4)
  discountPercent        Decimal  @default(0) @db.Decimal(5, 2)
  discountAmount         Decimal  @default(0) @db.Decimal(19, 4)
  taxCodeId              String?  @db.Uuid
  taxCode                String?
  taxCodeName            String?
  taxAmount              Decimal  @default(0) @db.Decimal(19, 4)
  lineSubtotal           Decimal  @db.Decimal(19, 4)
  lineTotal              Decimal  @db.Decimal(19, 4)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  quotation     Quotation                   @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  taxComponents QuotationItemTaxComponent[]

  @@index([tenantId])
  @@index([quotationId])
  @@index([productId])
  @@index([tenantId, unitOfMeasureId])
  @@index([tenantId, taxCodeId])
  @@map("quotation_items")
}

model QuotationItemTaxComponent {
  id                 String  @id @default(uuid()) @db.Uuid
  tenantId           String  @db.Uuid
  quotationItemId    String  @db.Uuid
  sequence           Int
  type               String
  name               String?
  rate               Decimal @db.Decimal(7, 4)
  componentTaxAmount Decimal @db.Decimal(19, 4)

  quotationItem QuotationItem @relation(fields: [quotationItemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([quotationItemId])
  @@map("quotation_item_tax_components")
}

model ProformaInvoice {
  id              String                @id @default(uuid()) @db.Uuid
  tenantId        String                @db.Uuid
  documentNumber  String
  sourceType      ProformaSourceType
  sourceId        String                @db.Uuid
  status          ProformaInvoiceStatus @default(DRAFT)
  customerId      String                @db.Uuid
  customerName    String
  billingAddress  String?
  shippingAddress String?
  notes           String?
  subtotal        Decimal               @db.Decimal(19, 4)
  discountTotal   Decimal               @default(0) @db.Decimal(19, 4)
  taxTotal        Decimal               @default(0) @db.Decimal(19, 4)
  total           Decimal               @db.Decimal(19, 4)
  issuedAt        DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  items      ProformaInvoiceItem[]
  salesOrder SalesOrder?

  @@unique([tenantId, documentNumber])
  @@index([tenantId])
  @@index([tenantId, sourceType, sourceId])
  @@index([tenantId, status])
  @@map("proforma_invoices")
}

model ProformaInvoiceItem {
  id                     String   @id @default(uuid()) @db.Uuid
  tenantId               String   @db.Uuid
  proformaInvoiceId      String   @db.Uuid
  productId              String   @db.Uuid
  productSku             String
  productName            String
  quantity               Decimal  @db.Decimal(19, 6)
  unitOfMeasureId        String?  @db.Uuid
  uomCode                String?
  uomName                String?
  conversionFactor       Decimal? @db.Decimal(19, 6)
  // Phase 3.3 (Sales Shipment COGS) — same snapshot rule as
  // QuotationItem.productTracksInventory above; copied forward to
  // SalesOrderItem when a Sales Order is converted from this Proforma
  // Invoice.
  productTracksInventory Boolean?
  unitPrice              Decimal  @db.Decimal(19, 4)
  discountPercent        Decimal  @default(0) @db.Decimal(5, 2)
  discountAmount         Decimal  @default(0) @db.Decimal(19, 4)
  taxCodeId              String?  @db.Uuid
  taxCode                String?
  taxCodeName            String?
  taxAmount              Decimal  @default(0) @db.Decimal(19, 4)
  lineSubtotal           Decimal  @db.Decimal(19, 4)
  lineTotal              Decimal  @db.Decimal(19, 4)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  proformaInvoice ProformaInvoice                   @relation(fields: [proformaInvoiceId], references: [id], onDelete: Cascade)
  taxComponents   ProformaInvoiceItemTaxComponent[]

  @@index([tenantId])
  @@index([proformaInvoiceId])
  @@index([productId])
  @@index([tenantId, unitOfMeasureId])
  @@index([tenantId, taxCodeId])
  @@map("proforma_invoice_items")
}

model ProformaInvoiceItemTaxComponent {
  id                    String  @id @default(uuid()) @db.Uuid
  tenantId              String  @db.Uuid
  proformaInvoiceItemId String  @db.Uuid
  sequence              Int
  type                  String
  name                  String?
  rate                  Decimal @db.Decimal(7, 4)
  componentTaxAmount    Decimal @db.Decimal(19, 4)

  proformaInvoiceItem ProformaInvoiceItem @relation(fields: [proformaInvoiceItemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([proformaInvoiceItemId])
  @@map("proforma_invoice_item_tax_components")
}

model SalesOrder {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @db.Uuid
  customerId        String           @db.Uuid
  quotationId       String?          @unique @db.Uuid
  proformaInvoiceId String?          @unique @db.Uuid
  status            SalesOrderStatus @default(DRAFT)
  customerName      String
  billingAddress    String?
  shippingAddress   String?
  notes             String?
  // Master-data/identity UUIDs intentionally have no foreign keys: that data
  // belongs to separate services/databases (mirrors Quotation.paymentTermId /
  // Quotation.salespersonId).
  paymentTermId     String?          @db.Uuid
  salespersonId     String?          @db.Uuid
  deliveryDate      DateTime?
  subtotal          Decimal          @db.Decimal(19, 4)
  discountTotal     Decimal          @default(0) @db.Decimal(19, 4)
  taxTotal          Decimal          @default(0) @db.Decimal(19, 4)
  total             Decimal          @db.Decimal(19, 4)
  confirmedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotation       Quotation?       @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  proformaInvoice ProformaInvoice? @relation(fields: [proformaInvoiceId], references: [id], onDelete: Restrict)
  items           SalesOrderItem[]
  shipments       Shipment[]

  @@index([tenantId])
  @@index([customerId])
  @@index([tenantId, status])
  @@index([tenantId, paymentTermId])
  @@index([tenantId, salespersonId])
  @@map("sales_orders")
}

model SalesOrderItem {
  id                     String   @id @default(uuid()) @db.Uuid
  tenantId               String   @db.Uuid
  salesOrderId           String   @db.Uuid
  productId              String   @db.Uuid
  productSku             String
  productName            String
  quantity               Decimal  @db.Decimal(19, 6)
  unitOfMeasureId        String?  @db.Uuid
  uomCode                String?
  uomName                String?
  conversionFactor       Decimal? @db.Decimal(19, 6)
  // Phase 3.3 (Sales Shipment COGS) — snapshotted from inventory-service's
  // Product.trackInventory when this order line is created directly (via
  // mapLines()'s existing getUomOptions() call), or copied forward verbatim
  // when this order is converted from a Quotation/ProformaInvoice (never a
  // fresh call in that path). Copied forward again to ShipmentItem at
  // shipment-creation time. NULL and false are always treated identically —
  // only an explicit true requires/enables COGS posting at shipment time.
  productTracksInventory Boolean?
  unitPrice              Decimal  @db.Decimal(19, 4)
  discountPercent        Decimal  @default(0) @db.Decimal(5, 2)
  discountAmount         Decimal  @default(0) @db.Decimal(19, 4)
  taxCodeId              String?  @db.Uuid
  taxCode                String?
  taxCodeName            String?
  taxAmount              Decimal  @default(0) @db.Decimal(19, 4)
  lineSubtotal           Decimal  @db.Decimal(19, 4)
  lineTotal              Decimal  @db.Decimal(19, 4)
  shippedQuantity        Decimal  @default(0) @db.Decimal(19, 6)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  salesOrder    SalesOrder                   @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  shipmentItems ShipmentItem[]
  taxComponents SalesOrderItemTaxComponent[]

  @@index([tenantId])
  @@index([salesOrderId])
  @@index([productId])
  @@index([tenantId, unitOfMeasureId])
  @@index([tenantId, taxCodeId])
  @@map("sales_order_items")
}

model SalesOrderItemTaxComponent {
  id                 String  @id @default(uuid()) @db.Uuid
  tenantId           String  @db.Uuid
  salesOrderItemId   String  @db.Uuid
  sequence           Int
  type               String
  name               String?
  rate               Decimal @db.Decimal(7, 4)
  componentTaxAmount Decimal @db.Decimal(19, 4)

  salesOrderItem SalesOrderItem @relation(fields: [salesOrderItemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([salesOrderItemId])
  @@map("sales_order_item_tax_components")
}

model Shipment {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @db.Uuid
  salesOrderId String         @db.Uuid
  warehouseId  String         @db.Uuid
  status       ShipmentStatus @default(PENDING_STOCK)
  shippedAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // Phase 3.3 (Sales Shipment COGS) — Sales-side cache of accounting-
  // service's own posting state, mirroring GoodsReceipt's identical Phase
  // 3.1 pattern exactly. No FK to accounting_db (separate database; soft
  // reference). The authoritative idempotency guard is accounting-service's
  // own unique constraint on (tenantId, sourceService, sourceType,
  // sourceId), never this column.
  accountingPostingStatus ShipmentPostingStatus @default(NOT_POSTED)
  journalEntryId          String?               @db.Uuid

  // Phase 3.16 (Shipment Cancellation / COGS Reversal) — populated only
  // once the accounting reversal succeeds (mirrors GoodsReceipt.
  // reversalJournalEntryId exactly). NULL while status is REVERSED but the
  // accounting reversal hasn't (yet) succeeded — retryable via
  // retryAccountingReversal(), same shape as every other reversal in this
  // codebase.
  reversalJournalEntryId String?   @db.Uuid
  reversedAt             DateTime?
  reversalReason         String?

  salesOrder SalesOrder     @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  items      ShipmentItem[]

  @@index([tenantId])
  @@index([salesOrderId])
  @@index([tenantId, status])
  @@map("shipments")
}

model ShipmentItem {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  shipmentId       String   @db.Uuid
  salesOrderItemId String   @db.Uuid
  productId        String   @db.Uuid
  productSku       String
  productName      String
  quantity         Decimal  @db.Decimal(19, 6)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // UOM snapshot + baseQuantity — Inventory Design v4, Sales Shipment UOM
  // Phase A. Snapshotted from SalesOrderItem once at line-creation time (new
  // shipments) or lazily at post()-retry time for a legacy pre-fix row when
  // safely resolvable (Phase A §5-B); left null forever if unresolvable
  // (§5-C), until a human resolves it via the resolve-conversion endpoint.
  // baseQuantity — never quantity — is the ONLY value ever sent to Inventory
  // (mirrors GoodsReceiptItem.baseQuantity exactly); post()/retry never
  // recomputes it from current ProductUnit data once persisted.
  unitOfMeasureId  String?  @db.Uuid
  uomCode          String?
  uomName          String?
  conversionFactor Decimal? @db.Decimal(19, 6)
  baseQuantity     Decimal? @db.Decimal(19, 6)

  // Set only when an unresolvable legacy line is manually resolved via
  // PATCH /shipments/:id/lines/:lineId/resolve-conversion (Phase A §5-C,
  // §11). Never set for a normally-resolved line.
  conversionResolvedBy     String?
  conversionResolvedAt     DateTime?
  conversionResolutionNote String?

  // Phase 3.3 (Sales Shipment COGS) — copied verbatim from the parent
  // SalesOrderItem at shipment-creation time, never re-fetched. NULL is
  // always treated identically to false — never blocks a shipment, never
  // participates in COGS posting.
  productTracksInventory Boolean?

  // Phase 3.3 (Sales Shipment COGS) — the authoritative issue-time cost
  // snapshot returned by Inventory's stock-issue call (never computed by
  // Sales itself). unitCost is the moving average AT THE MOMENT of this
  // shipment's issue (never re-derived later from a since-changed Stock
  // average); totalCost = baseQuantity × unitCost, exactly as Inventory
  // itself computed it. Nullable at the DB level only for legacy
  // pre-migration rows — the service never writes NULL for a new row.
  // This is the sole input to buildCogsPostingRequest(); never re-fetched
  // from Inventory at posting or retry time.
  unitCost  Decimal? @db.Decimal(19, 4)
  totalCost Decimal? @db.Decimal(19, 4)

  // Phase 3.12 (Sales Return / Credit Note) prerequisite — the authoritative
  // SALE StockMovement id this line's issue created, captured positionally
  // from Inventory's applyIssue() response inside finalizePosted(), mirrors
  // GoodsReceiptItem.inventoryMovementId exactly. Nullable at the DB level
  // only for legacy pre-migration rows; never overwritten once set. This is
  // the AUTHORITATIVE selector a Sales Return sends to Inventory's
  // applyReturn() as originalMovementId — never resolved by
  // (referenceType, referenceId, productId) lookup.
  inventoryMovementId String? @db.Uuid

  // Phase 3.12 (Sales Return / Credit Note) — cumulative base-quantity
  // already returned against this shipment line via CONFIRMED Sales Returns.
  // Caps repeat returns; mirrors GoodsReceiptItem.unmatchedReturnedQuantity's
  // capacity role, simplified since Sales has no matched/unmatched split.
  returnedQuantity Decimal @default(0) @db.Decimal(19, 6)

  shipment       Shipment          @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  salesOrderItem SalesOrderItem    @relation(fields: [salesOrderItemId], references: [id], onDelete: Restrict)
  returnLines    SalesReturnItem[] @relation("SalesReturnItemShipmentLine")

  @@index([tenantId])
  @@index([shipmentId])
  @@index([salesOrderItemId])
  @@index([productId])
  @@map("shipment_items")
}

model SalesInvoice {
  id              String                    @id @default(uuid()) @db.Uuid
  tenantId        String                    @db.Uuid
  invoiceNumber   String
  sourceType      SalesInvoiceSourceType?
  sourceId        String?                   @db.Uuid
  status          SalesInvoiceStatus        @default(DRAFT)
  customerId      String                    @db.Uuid
  customerName    String
  billingAddress  String?
  shippingAddress String?
  // Master-data/identity UUIDs intentionally have no foreign keys: that data
  // belongs to separate services/databases (mirrors Customer.paymentTermId /
  // Customer.salespersonId).
  paymentTermId   String?                   @db.Uuid
  salespersonId   String?                   @db.Uuid
  invoiceDate     DateTime
  dueDate         DateTime?
  notes           String?
  subtotal        Decimal                   @db.Decimal(19, 4)
  discountTotal   Decimal                   @default(0) @db.Decimal(19, 4)
  taxTotal        Decimal                   @default(0) @db.Decimal(19, 4)
  total           Decimal                   @db.Decimal(19, 4)
  // balanceDue is intentionally not persisted: it is always
  // total - amountPaid - amountCredited.
  amountPaid      Decimal                   @default(0) @db.Decimal(19, 4)
  // Phase 3.12 (Sales Return / Credit Note) — cumulative total of every
  // CONFIRMED Sales Return's revenue+tax reversal against this invoice,
  // maintained transactionally by SalesReturnsService.confirm()/reverse()
  // exactly like amountPaid is maintained by recordPayment()/reversePayment().
  // Deliberately does NOT affect paymentStatus below — paymentStatus means
  // only "cash payment state" (amountPaid vs total), unchanged; a fully
  // credited but never-paid invoice is UNPAID with balanceDue 0, which is
  // accurate (nothing owed, but no cash was ever collected).
  amountCredited  Decimal                   @default(0) @db.Decimal(19, 4)
  paymentStatus   SalesInvoicePaymentStatus @default(UNPAID)
  sentAt          DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  // Sales Accounting Integration — Sales-side cache of accounting-service's
  // own posting state (see enum comment above). No FK to accounting_db
  // (separate database; soft reference, mirrors paymentTermId above).
  accountingPostingStatus SalesInvoicePostingStatus @default(NOT_POSTED)
  journalEntryId          String?                   @db.Uuid
  reversalJournalEntryId  String?                   @db.Uuid

  customer    Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items       SalesInvoiceItem[]
  payments    SalesPayment[]
  returns     SalesReturn[]
  // Phase 3.14 (Standalone Sales Credit Note) — optional, traceability-only
  // back reference; a Credit Note is never required to reference an invoice
  // (see SalesCreditNote.salesInvoiceId below). Deliberately separate from
  // `returns` above — a Credit Note is not a SalesReturn.
  creditNotes SalesCreditNote[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([customerId])
  @@index([tenantId, status])
  @@index([tenantId, sourceType, sourceId])
  @@index([tenantId, paymentTermId])
  @@index([tenantId, salespersonId])
  @@index([tenantId, customerId])
  @@map("sales_invoices")
}

model SalesInvoiceItem {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  salesInvoiceId   String   @db.Uuid
  productId        String   @db.Uuid
  productSku       String
  productName      String
  quantity         Decimal  @db.Decimal(19, 6)
  unitOfMeasureId  String?  @db.Uuid
  uomCode          String?
  uomName          String?
  conversionFactor Decimal? @db.Decimal(19, 6)
  unitPrice        Decimal  @db.Decimal(19, 4)
  discountPercent  Decimal  @default(0) @db.Decimal(5, 2)
  discountAmount   Decimal  @default(0) @db.Decimal(19, 4)
  taxCodeId        String?  @db.Uuid
  taxCode          String?
  taxCodeName      String?
  taxAmount        Decimal  @default(0) @db.Decimal(19, 4)
  lineSubtotal     Decimal  @db.Decimal(19, 4)
  lineTotal        Decimal  @db.Decimal(19, 4)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Phase 3.12 (Sales Return / Credit Note) — cumulative quantity (same unit
  // as `quantity` above) already returned against this line via CONFIRMED
  // Sales Returns. Mirrors PurchaseInvoiceItem.returnedQuantity; also blocks
  // SalesInvoicesService.cancel() from cancelling a SENT invoice that has any
  // returned line.
  returnedQuantity Decimal @default(0) @db.Decimal(19, 6)

  salesInvoice  SalesInvoice                   @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  taxComponents SalesInvoiceItemTaxComponent[]
  returnLines   SalesReturnItem[]              @relation("SalesReturnItemInvoiceLine")

  @@index([tenantId])
  @@index([salesInvoiceId])
  @@index([productId])
  @@index([tenantId, unitOfMeasureId])
  @@index([tenantId, taxCodeId])
  @@map("sales_invoice_items")
}

model SalesInvoiceItemTaxComponent {
  id                 String  @id @default(uuid()) @db.Uuid
  tenantId           String  @db.Uuid
  salesInvoiceItemId String  @db.Uuid
  sequence           Int
  type               String
  name               String?
  rate               Decimal @db.Decimal(7, 4)
  componentTaxAmount Decimal @db.Decimal(19, 4)

  salesInvoiceItem SalesInvoiceItem @relation(fields: [salesInvoiceItemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([salesInvoiceItemId])
  @@map("sales_invoice_item_tax_components")
}

model SalesPayment {
  id              String             @id @default(uuid()) @db.Uuid
  tenantId        String             @db.Uuid
  salesInvoiceId  String             @db.Uuid
  amount          Decimal            @db.Decimal(19, 4)
  paymentDate     DateTime
  // Master-data UUID intentionally has no foreign key: that data belongs to
  // a separate service/database (mirrors SalesInvoice.paymentTermId).
  paymentMethodId String?            @db.Uuid
  reference       String?
  notes           String?
  status          SalesPaymentStatus @default(ACTIVE)

  // Sales Accounting Integration — Sales-side cache of accounting-service's
  // own posting state.
  accountingPostingStatus SalesPaymentPostingStatus @default(NOT_POSTED)
  journalEntryId          String?                   @db.Uuid
  reversalJournalEntryId  String?                   @db.Uuid
  reversedAt              DateTime?
  reversalReason          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salesInvoice SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([salesInvoiceId])
  @@map("sales_payments")
}

// Phase 3.12 (Sales Return / Credit Note). Anchors to one SalesInvoice (the
// document a Credit Note reduces) — mirrors PurchaseReturn's own single-
// document anchoring, substituting Sales' anchor (the invoice being credited)
// for Purchase's (the goods receipt whose inventory moved). The document
// itself doubles as the Credit Note — no separate CreditNote entity, mirrors
// PurchaseReturn's own "the return IS the debit note" precedent.
model SalesReturn {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @db.Uuid
  returnNumber   String
  salesInvoiceId String            @db.Uuid
  // Snapshot of the warehouse every shipment-linked line's stock movement
  // happens in; set only when >= 1 item has a shipmentItemId, null for a
  // pure invoice-only (financial-credit) return. Every shipment-linked
  // line's own Shipment.warehouseId must match this value (validated at
  // create() time) — mirrors PurchaseReturn.warehouseId's single-warehouse-
  // per-Inventory-call constraint.
  warehouseId    String?           @db.Uuid
  status         SalesReturnStatus @default(DRAFT)
  reason         String?
  returnedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  // Sales Accounting Integration — Sales-side cache of accounting-service's
  // own posting state, mirrors PurchaseReturn's identical fields exactly. No
  // FK to accounting_db (separate database; soft reference).
  accountingPostingStatus SalesReturnPostingStatus @default(NOT_POSTED)
  journalEntryId          String?                  @db.Uuid
  reversalJournalEntryId  String?                  @db.Uuid
  reversedAt              DateTime?
  reversalReason          String?

  salesInvoice SalesInvoice      @relation(fields: [salesInvoiceId], references: [id], onDelete: Restrict)
  items        SalesReturnItem[]

  @@unique([tenantId, returnNumber])
  @@index([tenantId])
  @@index([salesInvoiceId])
  @@index([tenantId, status])
  @@map("sales_returns")
}

model SalesReturnItem {
  id            String @id @default(uuid()) @db.Uuid
  tenantId      String @db.Uuid
  salesReturnId String @db.Uuid

  // Service-level invariant (not expressible as a DB constraint): at least
  // one of the two below must be set. Both set = the common case (invoiced
  // AND shipped goods coming back). Invoice-only = goodwill/pricing credit,
  // no stock movement. Shipment-only = physical return of never-invoiced
  // goods.
  salesInvoiceItemId String? @db.Uuid
  shipmentItemId     String? @db.Uuid

  productId   String
  productSku  String
  productName String

  // Commercial-unit quantity returned on this line.
  quantity     Decimal  @db.Decimal(19, 6)
  // Base quantity (× conversionFactor) — the ONLY value ever sent to
  // Inventory. Null when shipmentItemId is null (nothing to send).
  baseQuantity Decimal? @db.Decimal(19, 6)

  // Revenue/tax reversal snapshot, frozen from SalesInvoiceItem's own
  // pricing at confirm() time — never re-derived from current product/tax
  // state. Null when salesInvoiceItemId is null.
  unitPrice       Decimal? @db.Decimal(19, 4)
  discountPercent Decimal? @db.Decimal(5, 2)
  discountAmount  Decimal? @db.Decimal(19, 4)
  taxCodeId       String?  @db.Uuid
  taxCode         String?
  taxCodeName     String?
  taxAmount       Decimal? @db.Decimal(19, 4)
  lineSubtotal    Decimal? @db.Decimal(19, 4)
  lineTotal       Decimal? @db.Decimal(19, 4)

  // Inventory/COGS reversal snapshot — the original SALE movement's own
  // unitCost, read back verbatim (never re-derived). Null when
  // shipmentItemId is null.
  unitCost  Decimal? @db.Decimal(19, 4)
  totalCost Decimal? @db.Decimal(19, 4)

  // Prerequisite for THIS return's own future reversal — the SALE_RETURN
  // StockMovement this line created, captured positionally from Inventory's
  // applyReturn() response inside confirm(). Mirrors
  // PurchaseReturnItem.inventoryMovementId exactly. Null when shipmentItemId
  // is null (nothing was posted to Inventory for this line).
  inventoryMovementId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salesReturn      SalesReturn       @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  salesInvoiceItem SalesInvoiceItem? @relation("SalesReturnItemInvoiceLine", fields: [salesInvoiceItemId], references: [id], onDelete: Restrict)
  shipmentItem     ShipmentItem?     @relation("SalesReturnItemShipmentLine", fields: [shipmentItemId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([salesReturnId])
  @@index([salesInvoiceItemId])
  @@index([shipmentItemId])
  @@map("sales_return_items")
}

// ============================================================================
// Standalone Sales Credit Note V1 (Phase 3.14) — a standalone Accounts
// Receivable adjustment document. Deliberately independent of SalesReturn/
// Shipment/ShipmentItem: a Credit Note records a seller-side reduction of the
// amount owed by a customer (price correction, commercial discount after
// invoicing, billing adjustment, other pure customer-credit adjustment)
// WITHOUT any physical goods movement — it must never call
// InventoryStockClient and never touches SalesInvoice.amountCredited (that
// column remains exclusively owned by SalesReturnsService — see its own
// comment on SalesInvoice.amountCredited above). salesInvoiceId is optional,
// retained only as traceability when supplied; a standalone Credit Note with
// no invoice reference is equally valid.
//
// Document-level lifecycle: DRAFT -> POSTED -> REVERSED (never CONFIRMED —
// deliberately distinct vocabulary from SalesReturnStatus, mirrors Purchase
// Debit Note's own POSTED terminology instead). No third "reversal failed"
// posting status — a failed reversal attempt deliberately leaves
// accountingPostingStatus at POSTED, exactly like every other reversal in
// this codebase (see SalesCreditNotesService.reverse()'s own doc comment).
//
// Accounting (mirrors SalesInvoice's own postings, reversed — the exact same
// shape as SalesReturnsService.buildReturnPostingRequest()'s commercial-only
// case, i.e. a return with no shipment-linked lines):
//   Dr SALES_REVENUE       subtotal
//   Cr SALES_DISCOUNT      discountTotal, when > 0
//   Dr OUTPUT_TAX          taxTotal, when > 0
//   Cr ACCOUNTS_RECEIVABLE total
// sourceService 'sales-service', sourceType 'SALES_CREDIT_NOTE'. Reuses the
// existing SALES_REVENUE/SALES_DISCOUNT/OUTPUT_TAX/ACCOUNTS_RECEIVABLE roles
// and account mappings — no new GL account-mapping purpose.
// ============================================================================

enum SalesCreditNoteStatus {
  DRAFT
  POSTED
  REVERSED
}

// Mirrors SalesInvoicePostingStatus/SalesReturnPostingStatus's exact
// four-value shape. No third "reversal failed" value — see the model-group
// comment above.
enum SalesCreditNotePostingStatus {
  NOT_POSTED
  POSTED
  FAILED
  REVERSED
}

model SalesCreditNote {
  id               String @id @default(uuid()) @db.Uuid
  tenantId         String @db.Uuid
  creditNoteNumber String
  customerId       String @db.Uuid

  // Customer snapshot — frozen at create time from the live Customer record,
  // never re-fetched afterwards (same "snapshot, never re-derive" convention
  // as SalesOrder/SalesInvoice's own customer snapshots).
  customerName           String
  customerGstin          String?
  customerBillingAddress String?

  // Optional — when present, ties this Credit Note to a specific SENT
  // SalesInvoice for traceability only (verified to exist, belong to this
  // tenant, and be SENT at create time). Never required: a standalone Credit
  // Note with no invoice reference is equally valid and creates no
  // invoice-side effect (SalesInvoice.amountCredited is never touched by a
  // Credit Note — that column remains exclusively owned by SalesReturn).
  salesInvoiceId String? @db.Uuid

  creditNoteDate DateTime
  reason         String?
  notes          String?

  subtotal      Decimal @db.Decimal(19, 4)
  discountTotal Decimal @default(0) @db.Decimal(19, 4)
  taxTotal      Decimal @default(0) @db.Decimal(19, 4)
  total         Decimal @db.Decimal(19, 4)

  status SalesCreditNoteStatus @default(DRAFT)

  postedAt DateTime?
  postedBy String?   @db.Uuid

  reversedAt     DateTime?
  reversedBy     String?   @db.Uuid
  reversalReason String?

  // Sales-side cache of accounting-service's own posting state, mirroring
  // the exact SalesInvoice/SalesReturn pattern. No FK to accounting_db
  // (separate database; soft reference). The authoritative idempotency guard
  // is accounting-service's own unique constraint on
  // (tenantId, sourceService, sourceType, sourceId), never these columns.
  accountingPostingStatus SalesCreditNotePostingStatus @default(NOT_POSTED)
  journalEntryId          String?                      @db.Uuid
  reversalJournalEntryId  String?                      @db.Uuid

  createdBy String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer     Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesInvoice SalesInvoice?         @relation(fields: [salesInvoiceId], references: [id], onDelete: Restrict)
  items        SalesCreditNoteItem[]

  @@unique([tenantId, creditNoteNumber])
  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@index([tenantId, salesInvoiceId])
  @@map("sales_credit_notes")
}

model SalesCreditNoteItem {
  id                String @id @default(uuid()) @db.Uuid
  tenantId          String @db.Uuid
  salesCreditNoteId String @db.Uuid

  // Free-text line description — a Credit Note line is a commercial/
  // accounting adjustment, not necessarily tied to a specific product/UOM
  // (unlike SalesInvoiceItem), so no productId/UOM snapshot exists here.
  description String

  quantity  Decimal @db.Decimal(19, 6)
  unitPrice Decimal @db.Decimal(19, 4)

  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  discountAmount  Decimal @default(0) @db.Decimal(19, 4)

  // Tax code resolved fresh via AccountingTaxCodeClient at line-creation time
  // (mirrors SalesOrdersService.mapLines() — there is no order/invoice line
  // to copy a tax snapshot from, unlike SalesInvoiceItem).
  taxCodeId   String? @db.Uuid
  taxCode     String?
  taxCodeName String?
  taxAmount   Decimal @default(0) @db.Decimal(19, 4)

  lineSubtotal Decimal @db.Decimal(19, 4)
  lineTotal    Decimal @db.Decimal(19, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salesCreditNote SalesCreditNote                   @relation(fields: [salesCreditNoteId], references: [id], onDelete: Cascade)
  taxComponents   SalesCreditNoteItemTaxComponent[]

  @@index([tenantId])
  @@index([salesCreditNoteId])
  @@map("sales_credit_note_items")
}

// No createdAt/updatedAt — mirrors every other *ItemTaxComponent model in
// this schema (QuotationItemTaxComponent, ProformaInvoiceItemTaxComponent,
// SalesOrderItemTaxComponent, SalesInvoiceItemTaxComponent), none of which
// carry timestamps, unlike their Purchase-side counterparts.
model SalesCreditNoteItemTaxComponent {
  id                    String  @id @default(uuid()) @db.Uuid
  tenantId              String  @db.Uuid
  salesCreditNoteItemId String  @db.Uuid
  sequence              Int
  type                  String
  name                  String?
  rate                  Decimal @db.Decimal(7, 4)
  componentTaxAmount    Decimal @db.Decimal(19, 4)

  salesCreditNoteItem SalesCreditNoteItem @relation(fields: [salesCreditNoteItemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([salesCreditNoteItemId])
  @@map("sales_credit_note_item_tax_components")
}
