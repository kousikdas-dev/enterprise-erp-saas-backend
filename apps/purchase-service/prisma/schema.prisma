generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Infrastructure-only marker. Not a business entity. Do not expose via API.
model SchemaMeta {
  id        String   @id @default("foundation")
  appliedAt DateTime @default(now())

  @@map("_schema_meta")
}

enum PurchaseOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum GoodsReceiptStatus {
  PENDING_STOCK
  POSTED
}

// Phase 3.1 (GRNI Accounting) — GoodsReceipt posting can only ever be
// NOT_POSTED/POSTED/FAILED: Goods Receipt reversal is explicitly deferred
// in this phase, so no REVERSED value is representable here (mirrors
// SupplierPaymentPostingStatus, which is narrower than
// PurchaseInvoicePostingStatus for the identical reason — no reversal path).
enum GoodsReceiptPostingStatus {
  NOT_POSTED
  POSTED
  FAILED
}

enum SupplierAddressType {
  BILLING
  DISPATCH
}

model Supplier {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  code             String
  name             String
  company          String?
  email            String?
  phone            String?
  jobPosition      String?
  website          String?
  gstin            String?
  tags             String[] @default([])
  paymentTermId    String?  @db.Uuid
  fiscalPositionId String?  @db.Uuid
  industryId       String?  @db.Uuid
  notes            String?
  address          String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
  addresses      SupplierAddress[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, paymentTermId])
  @@index([tenantId, fiscalPositionId])
  @@index([tenantId, industryId])
  @@map("suppliers")
}

model SupplierAddress {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId     String              @db.Uuid
  supplierId   String              @db.Uuid
  type         SupplierAddressType
  name         String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  postalCode   String?
  country      String
  phone        String?
  isDefault    Boolean             @default(false)
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  purchaseOrdersAsBilling  PurchaseOrder[] @relation("PurchaseOrderBillingAddress")
  purchaseOrdersAsDispatch PurchaseOrder[] @relation("PurchaseOrderDispatchAddress")

  @@index([tenantId])
  @@index([supplierId])
  @@index([tenantId, supplierId, type])
  @@map("supplier_addresses")
}

model PurchaseOrder {
  id         String              @id @default(uuid()) @db.Uuid
  tenantId   String              @db.Uuid
  poNumber   String
  supplierId String              @db.Uuid
  status     PurchaseOrderStatus @default(DRAFT)

  // Supplier snapshot — frozen at create time, re-derived only if
  // supplierId changes while the order is still DRAFT.
  supplierName              String
  supplierGstin             String?
  supplierBillingAddress    String?
  supplierDispatchAddress   String?
  // References to the specific SupplierAddress rows the snapshot text above
  // was formatted from. Same-database FKs (unlike paymentTermId/buyerId
  // below), so onDelete: SetNull keeps the frozen text intact even if the
  // address is later removed — deleting a supplier address must never be
  // blocked by, or corrupt, an existing purchase order.
  supplierBillingAddressId  String? @db.Uuid
  supplierDispatchAddressId String? @db.Uuid
  // Master-data/Identity UUIDs intentionally have no foreign keys: that data
  // belongs to separate services/databases (mirrors SalesOrder.paymentTermId
  // / SalesOrder.salespersonId). paymentTermId defaults from the supplier at
  // create time but may be explicitly overridden per order.
  paymentTermId             String? @db.Uuid
  buyerId                   String? @db.Uuid

  supplierReference    String?
  expectedDeliveryDate DateTime?

  notes     String?
  orderDate DateTime @default(now())

  subtotal      Decimal @db.Decimal(19, 4)
  discountTotal Decimal @default(0) @db.Decimal(19, 4)
  taxTotal      Decimal @default(0) @db.Decimal(19, 4)
  total         Decimal @db.Decimal(19, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplier         Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  billingAddress   SupplierAddress?    @relation("PurchaseOrderBillingAddress", fields: [supplierBillingAddressId], references: [id], onDelete: SetNull)
  dispatchAddress  SupplierAddress?    @relation("PurchaseOrderDispatchAddress", fields: [supplierDispatchAddressId], references: [id], onDelete: SetNull)
  items            PurchaseOrderItem[]
  goodsReceipts    GoodsReceipt[]
  purchaseInvoices PurchaseInvoice[]

  @@unique([tenantId, poNumber])
  @@index([tenantId])
  @@index([supplierId])
  @@index([tenantId, status])
  @@index([tenantId, paymentTermId])
  @@index([tenantId, buyerId])
  @@index([tenantId, supplierBillingAddressId])
  @@index([tenantId, supplierDispatchAddressId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String @id @default(uuid()) @db.Uuid
  tenantId        String @db.Uuid
  purchaseOrderId String @db.Uuid
  productId       String @db.Uuid

  // Product snapshot — frozen at create/update time, never re-derived.
  productSku  String
  productName String

  quantity Decimal @db.Decimal(19, 6)

  // UOM snapshot — conversionFactor is stored for record-keeping only and
  // never affects quantity/cost math (matches Sales precedent).
  unitOfMeasureId  String?  @db.Uuid
  uomCode          String?
  uomName          String?
  conversionFactor Decimal? @db.Decimal(19, 6)

  // Phase 3.2 (GRNI Clearing / PPV) — snapshotted verbatim from
  // inventory-service's Product.trackInventory at line-creation time (via
  // the same InventoryProductClient.getUomOptions() round-trip already used
  // for UOM resolution — no separate call). Never re-fetched afterwards.
  // Nullable permanently, not just during a migration window: every row
  // created before this column existed has NULL here and there is no way to
  // retroactively know what the flag was at that historical point in time.
  // NULL is always treated identically to false — it never blocks
  // PurchaseInvoice confirm() and never participates in GRNI/PPV posting.
  productTracksInventory Boolean?

  unitCost Decimal @db.Decimal(19, 4)

  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  discountAmount  Decimal @default(0) @db.Decimal(19, 4)

  taxCodeId   String? @db.Uuid
  taxCode     String?
  taxCodeName String?
  taxAmount   Decimal @default(0) @db.Decimal(19, 4)

  lineSubtotal Decimal @db.Decimal(19, 4)
  lineTotal    Decimal @db.Decimal(19, 4)

  receivedQuantity Decimal  @default(0) @db.Decimal(19, 6)
  // Commercial-UOM quantity billed so far across CONFIRMED PurchaseInvoices
  // for this line (Purchase Invoice V1). Never mixed with baseQuantity.
  // Accumulated only at PurchaseInvoice CONFIRM time, reversed on CONFIRMED
  // invoice cancellation — DRAFT invoices never touch this column.
  invoicedQuantity Decimal  @default(0) @db.Decimal(19, 6)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  purchaseOrder        PurchaseOrder                   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  goodsReceiptItems    GoodsReceiptItem[]
  taxComponents        PurchaseOrderItemTaxComponent[]
  purchaseInvoiceItems PurchaseInvoiceItem[]

  @@index([tenantId])
  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

model PurchaseOrderItemTaxComponent {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @db.Uuid
  purchaseOrderItemId String   @db.Uuid
  sequence            Int
  type                String
  name                String?
  rate                Decimal  @db.Decimal(7, 4)
  componentTaxAmount  Decimal  @db.Decimal(19, 4)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([purchaseOrderItemId])
  @@map("purchase_order_item_tax_components")
}

model GoodsReceipt {
  id              String             @id @default(uuid()) @db.Uuid
  tenantId        String             @db.Uuid
  purchaseOrderId String             @db.Uuid
  warehouseId     String             @db.Uuid
  status          GoodsReceiptStatus @default(PENDING_STOCK)
  receivedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  // Phase 3.1 (GRNI Accounting) — Purchase-side cache of accounting-service's
  // own posting state, mirroring the exact PurchaseInvoice/SupplierPayment
  // pattern (Phase C1/C2) above. No reversalJournalEntryId: Goods Receipt
  // reversal is deferred in this phase (see GoodsReceiptPostingStatus). No
  // FK to accounting_db (separate database; soft reference). The
  // authoritative idempotency guard is accounting-service's own unique
  // constraint on (tenantId, sourceService, sourceType, sourceId), never
  // this column.
  accountingPostingStatus GoodsReceiptPostingStatus @default(NOT_POSTED)
  journalEntryId          String?                   @db.Uuid

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  items         GoodsReceiptItem[]
  // Phase 3.5 (Purchase Return) — a Purchase Return is scoped to exactly one
  // GoodsReceipt (see PurchaseReturn's own model comment for the rationale).
  purchaseReturns PurchaseReturn[]

  @@index([tenantId])
  @@index([purchaseOrderId])
  @@index([tenantId, status])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                  String  @id @default(uuid()) @db.Uuid
  tenantId            String  @db.Uuid
  goodsReceiptId      String  @db.Uuid
  purchaseOrderItemId String  @db.Uuid
  quantity            Decimal @db.Decimal(19, 6) // commercial/PO UOM receiving quantity — never converted

  // Product snapshot — copied verbatim from the parent PurchaseOrderItem at
  // receipt-creation time, never re-fetched from Product/inventory-service
  // (Section 19.3.1/19.7). NOT NULL: the parent PurchaseOrderItem columns are
  // themselves NOT NULL and every row has a required FK parent (migration
  // 20260917120000_gr_v1_uom_snapshot adds these nullable, backfills, then
  // tightens to NOT NULL once every row is proven populated).
  productId   String @db.Uuid
  productSku  String
  productName String

  // UOM snapshot — copied verbatim from the parent PurchaseOrderItem, never
  // re-resolved from current ProductUnit/master data (Section 19.3.1/19.3.4).
  // Nullable, mirroring PurchaseOrderItem's own nullable UOM columns.
  unitOfMeasureId  String?  @db.Uuid
  uomCode          String?
  uomName          String?
  conversionFactor Decimal? @db.Decimal(19, 6)

  // Phase 3.2 (GRNI Clearing / PPV) — copied verbatim from the parent
  // PurchaseOrderItem.productTracksInventory, never re-fetched. Nullable for
  // the same permanent reason as the PurchaseOrderItem column above.
  productTracksInventory Boolean?

  // Derived once at creation: quantity × conversionFactor. The ONLY value
  // ever sent to Inventory (Section 19.3.3). Nullable at the DB level only
  // for legacy pre-migration rows that could not be safely backfilled
  // (Section 19.8.3, D12) — the service never writes NULL for a new row;
  // post()/retry rejects a NULL baseQuantity rather than guessing.
  baseQuantity Decimal? @db.Decimal(19, 6)

  // Phase 3.1 (GRNI Accounting) — snapshotted verbatim from the parent
  // PurchaseOrderItem.unitCost at receipt-creation time, never re-resolved
  // (same "snapshot, never re-derive" convention as every other column
  // above). This is the expected/ordered cost — the only cost available at
  // receipt time, since no invoice exists yet. Nullable at the DB level only
  // for legacy pre-migration rows; the service never writes NULL for a new
  // row. Used both as the Inventory receipt's unitCost line and as the GRNI
  // accrual amount (baseQuantity x unitCost). Never fabricated/backfilled
  // for historical rows (D12-style rule, mirrors baseQuantity/conversionFactor).
  unitCost Decimal? @db.Decimal(19, 4)

  // Phase 3.5 (Purchase Return) — base-UOM quantity returned via
  // UNMATCHED_RECEIPT allocations only (the portion of this line that was
  // never invoiced). Deliberately NOT named `returnedQuantity`: that name is
  // already taken, with a DIFFERENT scope, by
  // PurchaseInvoiceGoodsReceiptMatch.returnedQuantity (matched-bucket
  // returns only) one join away — see that model's comment for the full
  // two-counter split. Invariant:
  // (invoiceMatch?.matchedQuantity ?? 0) + unmatchedReturnedQuantity <= baseQuantity.
  unmatchedReturnedQuantity Decimal @default(0) @db.Decimal(19, 6)
  // Phase 3.5 (Purchase Return) — soft reference (no FK; inventory-service
  // is a separate database, mirrors every other cross-service reference in
  // this schema) to the specific inventory-service StockMovement (type
  // PURCHASE) created when this receipt line was posted. This is the
  // AUTHORITATIVE selector a Purchase Return sends to inventory-service's
  // stock-returns endpoint as `originalMovementId` — never resolved by
  // (referenceType, referenceId, productId) lookup, per that endpoint's own
  // design. NULL for every row created before this phase (legacy receipts
  // cannot be returned via the new primitive — a known, documented
  // limitation, not backfilled).
  inventoryMovementId       String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goodsReceipt         GoodsReceipt          @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem    PurchaseOrderItem     @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  purchaseInvoiceItems PurchaseInvoiceItem[]
  // Phase 3.2 (GRNI Clearing / PPV) — at most one match row per receipt
  // item (see PurchaseInvoiceGoodsReceiptMatch below), created lazily the
  // first time this item is matched by a PurchaseInvoiceItem.
  invoiceMatch         PurchaseInvoiceGoodsReceiptMatch?
  // Phase 3.5 (Purchase Return) — a receipt line may be referenced by more
  // than one PurchaseReturnItem over time (partial returns), each write-once
  // via its own PurchaseReturnItemAllocation rows.
  purchaseReturnItems  PurchaseReturnItem[]

  @@index([tenantId])
  @@index([goodsReceiptId])
  @@index([purchaseOrderItemId])
  @@map("goods_receipt_items")
}

// ============================================================================
// Purchase Invoice V1 (PURCHASE_MODULE_PLAN.md Section 22, Phase A) and
// Supplier Payment V1 (Section 22.9-22.10, Phase B).
// No currency, no payment reversal/cancellation. See Section 22 for the
// full architecture.
//
// Phase C1/C2 (Purchase Accounting Integration): confirm()/recordPayment()
// post a journal entry to accounting-service after their own transaction
// commits (never inside it — accounting-service is a separate database, no
// distributed transaction is attempted); cancel() reverses that journal
// only when one was actually POSTED. accountingPostingStatus/journalEntryId
// (/reversalJournalEntryId on PurchaseInvoice only) are Purchase-side
// caches of accounting-service's own state — the authoritative idempotency
// guard is accounting-service's own unique constraint on
// (tenantId, sourceService, sourceType, sourceId), never these columns.
// ============================================================================

enum PurchaseInvoiceStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum PurchaseInvoicePaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

// PurchaseInvoice posting can additionally be REVERSED (via cancel() after
// a POSTED journal existed) — SupplierPayment has no reversal path in this
// phase (mirrors the existing "no payment reversal" limitation), so its own
// posting-status enum below is deliberately narrower (no REVERSED value is
// representable for it).
enum PurchaseInvoicePostingStatus {
  NOT_POSTED
  POSTED
  FAILED
  REVERSED
}

enum SupplierPaymentPostingStatus {
  NOT_POSTED
  POSTED
  FAILED
}

model PurchaseInvoice {
  id                    String                @id @default(uuid()) @db.Uuid
  tenantId              String                @db.Uuid
  invoiceNumber         String
  supplierInvoiceNumber String?
  purchaseOrderId       String                @db.Uuid
  status                PurchaseInvoiceStatus @default(DRAFT)

  supplierId             String  @db.Uuid
  // Supplier snapshot — copied from the referenced PurchaseOrder's own
  // already-frozen header snapshot, never re-fetched from live Supplier.
  supplierName           String
  supplierGstin          String?
  supplierBillingAddress String?
  // Master-data UUID intentionally has no foreign key: mirrors
  // PurchaseOrder.paymentTermId (that data belongs to a separate service).
  paymentTermId          String? @db.Uuid

  invoiceDate DateTime
  dueDate     DateTime?
  notes       String?

  subtotal      Decimal                      @db.Decimal(19, 4)
  discountTotal Decimal                      @default(0) @db.Decimal(19, 4)
  taxTotal      Decimal                      @default(0) @db.Decimal(19, 4)
  total         Decimal                      @db.Decimal(19, 4)
  // balanceDue is intentionally not persisted: it is always total - amountPaid
  // (mirrors SalesInvoice). amountPaid/paymentStatus are written by the future
  // Supplier Payment phase (Phase B); Phase A leaves them at their defaults.
  amountPaid    Decimal                      @default(0) @db.Decimal(19, 4)
  paymentStatus PurchaseInvoicePaymentStatus @default(UNPAID)

  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Phase C1/C2 — Purchase-side cache of accounting-service's own posting
  // state (see the model-group comment above). No foreign key: accounting_db
  // is a separate database, mirrors every other cross-service soft reference
  // in this schema (e.g. paymentTermId above).
  accountingPostingStatus PurchaseInvoicePostingStatus @default(NOT_POSTED)
  journalEntryId          String?                      @db.Uuid
  reversalJournalEntryId  String?                      @db.Uuid

  purchaseOrder PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  items         PurchaseInvoiceItem[]
  payments      SupplierPayment[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([purchaseOrderId])
  @@index([tenantId, status])
  @@index([tenantId, paymentTermId])
  @@map("purchase_invoices")
}

model PurchaseInvoiceItem {
  id                  String  @id @default(uuid()) @db.Uuid
  tenantId            String  @db.Uuid
  purchaseInvoiceId   String  @db.Uuid
  purchaseOrderItemId String  @db.Uuid
  // Optional — when present, ties this invoice line to a specific physical
  // receipt for traceability; quantity validation always stays at the
  // purchaseOrderItemId aggregate level regardless (Section 22 Decision B).
  goodsReceiptItemId  String? @db.Uuid

  // Product/UOM snapshot — copied from GoodsReceiptItem when
  // goodsReceiptItemId is supplied, otherwise from PurchaseOrderItem.
  // Never re-fetched from Product/inventory-service.
  productId        String   @db.Uuid
  productSku       String
  productName      String
  unitOfMeasureId  String?  @db.Uuid
  uomCode          String?
  uomName          String?
  conversionFactor Decimal? @db.Decimal(19, 6)

  // Phase 3.2 (GRNI Clearing / PPV) — copied from the same productSource
  // (GoodsReceiptItem when goodsReceiptItemId is supplied, otherwise
  // PurchaseOrderItem) as every other snapshot field above. Nullable for the
  // same permanent reason as the PurchaseOrderItem/GoodsReceiptItem columns.
  // Only an explicit `true` requires goodsReceiptItemId and participates in
  // GRNI clearing/PPV at confirm() — NULL and false behave identically.
  productTracksInventory Boolean?

  // Commercial UOM quantity actually billed — never a base-UOM quantity.
  // May legitimately differ from the PO line's quantity/unitCost/discount
  // (that difference is matching information, never silently overwritten).
  quantity        Decimal @db.Decimal(19, 6)
  unitCost        Decimal @db.Decimal(19, 4)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  discountAmount  Decimal @default(0) @db.Decimal(19, 4)

  // Tax code/rate structure copied from the parent PurchaseOrderItem, never
  // re-resolved via AccountingTaxCodeClient; amounts are still computed
  // against this line's own lineSubtotal, not copied verbatim.
  taxCodeId   String? @db.Uuid
  taxCode     String?
  taxCodeName String?
  taxAmount   Decimal @default(0) @db.Decimal(19, 4)

  lineSubtotal Decimal @db.Decimal(19, 4)
  lineTotal    Decimal @db.Decimal(19, 4)

  // Phase 3.5 (Purchase Return) — base-UOM quantity of THIS invoice line
  // ("slice") consumed by MATCHED_INVOICE PurchaseReturnItemAllocation rows.
  // Invariant: returnedQuantity <= quantity × conversionFactor. Oldest-first
  // matched-bucket allocation consumes slices ordered by the parent
  // PurchaseInvoice.confirmedAt, draining each slice's own remaining
  // capacity (quantity × conversionFactor − returnedQuantity) before moving
  // to the next. Also consulted by PurchaseInvoicesService.cancel(), which
  // must reject cancelling a CONFIRMED invoice while any of its items has
  // returnedQuantity > 0 (cancelling would otherwise double-reverse the
  // accounting effect a Purchase Return already posted for that quantity).
  returnedQuantity Decimal @default(0) @db.Decimal(19, 6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseInvoice   PurchaseInvoice                   @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem                 @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  goodsReceiptItem  GoodsReceiptItem?                 @relation(fields: [goodsReceiptItemId], references: [id], onDelete: Restrict)
  taxComponents     PurchaseInvoiceItemTaxComponent[]
  // Phase 3.5 (Purchase Return) — write-once historical allocation rows that
  // consumed part of this slice; never updated after creation.
  returnAllocations PurchaseReturnItemAllocation[]

  @@index([tenantId])
  @@index([purchaseInvoiceId])
  @@index([purchaseOrderItemId])
  @@index([goodsReceiptItemId])
  @@map("purchase_invoice_items")
}

model PurchaseInvoiceItemTaxComponent {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @db.Uuid
  purchaseInvoiceItemId String   @db.Uuid
  sequence              Int
  type                  String
  name                  String?
  rate                  Decimal  @db.Decimal(7, 4)
  componentTaxAmount    Decimal  @db.Decimal(19, 4)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  purchaseInvoiceItem PurchaseInvoiceItem @relation(fields: [purchaseInvoiceItemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([purchaseInvoiceItemId])
  @@map("purchase_invoice_item_tax_components")
}

// Phase 3.2 (GRNI Clearing / PPV) — source of truth for how much of a
// GoodsReceiptItem's baseQuantity has been claimed by CONFIRMED
// PurchaseInvoiceItems (matchedQuantity). One row per GoodsReceiptItem,
// created lazily on first match. No FIFO/cost-layer concept: this is a flat
// running total, mirroring PurchaseOrderItem.invoicedQuantity. No monetary
// column is stored — GRNI clearing value is always recomputed at posting
// time from GoodsReceiptItem.unitCost, never persisted redundantly.
//
// Phase 3.5 (Purchase Return) correction: matchedQuantity represents base
// quantity CURRENTLY claimed by CONFIRMED invoices and is permanent with
// respect to returns — a Purchase Return never decrements it (only invoice
// cancellation does; that is a genuinely different event). returnedQuantity
// is therefore scoped to MATCHED-bucket returns only (base qty returned via
// MATCHED_INVOICE PurchaseReturnItemAllocation rows against invoice slices
// that reference a GoodsReceiptItem this row is keyed to), bounded by
// `returnedQuantity <= matchedQuantity` — NOT by baseQuantity directly. The
// complementary "never-invoiced" bucket has its own, separate counter,
// GoodsReceiptItem.unmatchedReturnedQuantity, bounded by
// `matchedQuantity + GoodsReceiptItem.unmatchedReturnedQuantity <= baseQuantity`.
// A single shared counter cannot correctly serve both buckets at once (a
// unit of "returned" would mean two different things depending on which
// bucket it came from) — see GoodsReceiptItem.unmatchedReturnedQuantity's
// own comment for the full split.
//
// Lock-order rule for every current and future flow that touches this
// table: acquire goods_receipt_items THEN
// purchase_invoice_goods_receipt_matches, always last in the transaction's
// lock chain, always in ascending id order when locking more than one row.
// PurchaseInvoicesService.confirm()/cancel() follow this today;
// PurchaseReturnsService.confirm() follows the same order, additionally
// locking purchase_invoice_items (a table PurchaseInvoicesService never
// locks) between goods_receipt_items and this table when a MATCHED_INVOICE
// allocation is needed — never after this table.
model PurchaseInvoiceGoodsReceiptMatch {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @db.Uuid
  goodsReceiptItemId String   @unique @db.Uuid

  // Base-UOM quantity matched to CONFIRMED PurchaseInvoiceItems so far.
  // Accumulated only at PurchaseInvoice CONFIRM time, reversed on CONFIRMED
  // invoice cancellation — mirrors PurchaseOrderItem.invoicedQuantity. Never
  // touched by a Purchase Return (Phase 3.5) — see the model comment above.
  matchedQuantity Decimal @default(0) @db.Decimal(19, 6)
  // Phase 3.5 (Purchase Return) — base-UOM quantity returned via
  // MATCHED_INVOICE allocations only (the matched bucket). Bound:
  // returnedQuantity <= matchedQuantity. See the model comment above for
  // the full two-bucket/two-counter split.
  returnedQuantity Decimal @default(0) @db.Decimal(19, 6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goodsReceiptItem GoodsReceiptItem @relation(fields: [goodsReceiptItemId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("purchase_invoice_goods_receipt_matches")
}

// Supplier Payment V1 (Section 22.9-22.10, Phase B) — a payment recorded
// against a CONFIRMED PurchaseInvoice's balance. Child resource of
// PurchaseInvoice (mirrors SalesPayment's relationship to SalesInvoice
// exactly); no reversal/cancellation endpoint (Phase C1/C2 posting mirrors
// that: a FAILED posting simply has no retry endpoint of its own here,
// unlike PurchaseInvoice — see the Purchase Invoice model-group comment).
model SupplierPayment {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  purchaseInvoiceId String   @db.Uuid
  amount            Decimal  @db.Decimal(19, 4)
  paymentDate       DateTime
  // Master-data UUID intentionally has no foreign key: mirrors
  // PurchaseInvoice.paymentTermId / SalesPayment.paymentMethodId (that data
  // belongs to a separate service/database). Reuses the single, existing
  // Payment Method concept shared with Sales — no Purchase-specific master.
  paymentMethodId   String?  @db.Uuid
  reference         String?
  notes             String?

  // Phase C1/C2 — Purchase-side cache of accounting-service's own posting
  // state. No reversalJournalEntryId here: SupplierPayment has no reversal
  // path in this phase (see model-group comment above PurchaseInvoice).
  accountingPostingStatus SupplierPaymentPostingStatus @default(NOT_POSTED)
  journalEntryId          String?                      @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([purchaseInvoiceId])
  @@map("supplier_payments")
}

// ============================================================================
// Purchase Return V1 (Phase 3.5). No approval workflow: DRAFT -> CONFIRMED
// directly, mirroring GoodsReceipt's two-state PENDING_STOCK -> POSTED shape
// (no CANCELLED state in this phase — reversal is a distinct later phase,
// Phase 3.6, that creates its own offsetting records rather than mutating
// these). Moving Average only; inventory-service remains the sole valuation
// authority (Purchase Return never adds accounting-service dependencies to
// inventory-service, and never re-derives a cost inventory-service already
// computed).
//
// A Purchase Return is scoped to exactly one GoodsReceipt (never a whole
// PurchaseOrder): inventory-service's stock-returns endpoint accepts a
// single warehouseId per call, and GoodsReceipt is already single-warehouse,
// so scoping a return to one receipt avoids a multi-warehouse/multi-call
// grouping problem a PO-scoped return would need to solve instead. Lines can
// still reference any GoodsReceiptItem belonging to that one receipt.
//
// Allocation priority (PurchaseReturnsService.confirm()): first consume the
// receipt line's unmatched (never-invoiced) capacity at GoodsReceiptItem.
// unitCost, then consume matched-invoice slices oldest-first at each
// slice's own net-of-discount cost, splitting the difference to
// PURCHASE_PRICE_VARIANCE. See GoodsReceiptItem.unmatchedReturnedQuantity
// and PurchaseInvoiceGoodsReceiptMatch.returnedQuantity for the two
// independent capacity counters this relies on, and
// PurchaseReturnItemAllocation below for the write-once per-bucket record of
// what was actually allocated.
// ============================================================================

enum PurchaseReturnStatus {
  DRAFT
  CONFIRMED
  // Phase 3.6 — undoes a CONFIRMED return's effects on Inventory and the two
  // return-quantity counters (never CANCELLED: mirrors Opening Stock's own
  // vocabulary for "undo a posted inventory-affecting document," not
  // Purchase Invoice's pre-effect CANCELLED).
  REVERSED
}

// Mirrors PurchaseInvoicePostingStatus's exact four-value shape (Phase 3.6
// adds REVERSED). No third "reversal failed" value: a failed reversal
// attempt deliberately leaves this at POSTED, exactly like
// PurchaseInvoicesService.attemptInvoiceReversal() — see reverse()'s own
// doc comment in purchase-returns.service.ts.
enum PurchaseReturnPostingStatus {
  NOT_POSTED
  POSTED
  FAILED
  REVERSED
}

enum PurchaseReturnAllocationType {
  UNMATCHED_RECEIPT
  MATCHED_INVOICE
}

model PurchaseReturn {
  id             String               @id @default(uuid()) @db.Uuid
  tenantId       String               @db.Uuid
  returnNumber   String
  goodsReceiptId String               @db.Uuid
  // Copied verbatim from goodsReceipt.warehouseId at creation time, never
  // re-fetched — same "snapshot, never re-derive" convention as every other
  // cross-document field in this schema. The single value sent to
  // inventory-service's stock-returns endpoint for every line in this return.
  warehouseId    String               @db.Uuid
  status         PurchaseReturnStatus @default(DRAFT)
  reason         String?
  returnedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  // Purchase-side cache of accounting-service's own posting state, mirroring
  // the exact GoodsReceipt/PurchaseInvoice pattern. No FK to accounting_db
  // (separate database; soft reference). The authoritative idempotency
  // guard is accounting-service's own unique constraint on
  // (tenantId, sourceService, sourceType, sourceId), never this column.
  accountingPostingStatus PurchaseReturnPostingStatus @default(NOT_POSTED)
  journalEntryId          String?                     @db.Uuid

  // Phase 3.6 — populated only once the accounting reversal succeeds
  // (mirrors PurchaseInvoice.reversalJournalEntryId exactly). NULL while
  // status is REVERSED but the accounting reversal hasn't (yet) succeeded —
  // retryable via retryAccountingReversal(), same shape as the invoice flow.
  reversalJournalEntryId String?   @db.Uuid
  reversedAt             DateTime?
  reversalReason         String?

  goodsReceipt GoodsReceipt         @relation(fields: [goodsReceiptId], references: [id], onDelete: Restrict)
  items        PurchaseReturnItem[]

  @@unique([tenantId, returnNumber])
  @@index([tenantId])
  @@index([goodsReceiptId])
  @@index([tenantId, status])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id                 String  @id @default(uuid()) @db.Uuid
  tenantId           String  @db.Uuid
  purchaseReturnId   String  @db.Uuid
  goodsReceiptItemId String  @db.Uuid

  // Product/UOM snapshot — copied verbatim from the parent GoodsReceiptItem
  // at creation time, never re-fetched (same convention as
  // GoodsReceiptItem/PurchaseInvoiceItem's own snapshots).
  productId        String   @db.Uuid
  productSku       String
  productName      String
  unitOfMeasureId  String?  @db.Uuid
  uomCode          String?
  uomName          String?
  conversionFactor Decimal? @db.Decimal(19, 6)

  quantity     Decimal @db.Decimal(19, 6) // commercial UOM, same unit as the GR line — never converted
  // Derived once at creation: quantity × conversionFactor. The ONLY value
  // ever sent to Inventory (mirrors GoodsReceiptItem.baseQuantity's own rule).
  baseQuantity Decimal @db.Decimal(19, 6)

  // Phase 3.6 (Purchase Return reversal, prerequisite) — soft reference to
  // the PURCHASE_RETURN StockMovement this line's own applyReturn() call
  // created, captured positionally from Inventory's response in confirm()
  // (mirrors GoodsReceiptItem.inventoryMovementId's own zip-not-lookup rule
  // above). Required so a future reversal can target the exact movement to
  // reverse, by id, never by (referenceType, referenceId, productId) lookup.
  // NULL only for rows confirmed before this phase existed — a known,
  // documented limitation, not backfilled.
  inventoryMovementId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseReturn   PurchaseReturn                 @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  goodsReceiptItem GoodsReceiptItem               @relation(fields: [goodsReceiptItemId], references: [id], onDelete: Restrict)
  allocations      PurchaseReturnItemAllocation[]

  @@index([tenantId])
  @@index([purchaseReturnId])
  @@index([goodsReceiptItemId])
  @@map("purchase_return_items")
}

// Write-once historical record of how one PurchaseReturnItem's quantity was
// split between the unmatched-receipt and matched-invoice cost buckets at
// CONFIRM time. NEVER updated after creation — Phase 3.6 reversal creates
// new offsetting records elsewhere and must not touch these rows (hence no
// updatedAt column here, unlike every other model in this schema).
model PurchaseReturnItemAllocation {
  id                    String                       @id @default(uuid()) @db.Uuid
  tenantId              String                       @db.Uuid
  purchaseReturnItemId  String                       @db.Uuid
  allocationType        PurchaseReturnAllocationType
  // Set only for MATCHED_INVOICE allocations — the specific invoice line
  // ("slice") this allocation consumed.
  purchaseInvoiceItemId String?                      @db.Uuid

  baseQuantity      Decimal  @db.Decimal(19, 6)
  // Snapshot of GoodsReceiptItem.unitCost at allocation time. Always set:
  // both allocation types return inventory value at receipt cost.
  receiptUnitCost   Decimal  @db.Decimal(19, 4)
  receiptCostAmount Decimal  @db.Decimal(19, 4)
  // MATCHED_INVOICE only — the slice's own net-of-discount unit cost
  // (lineSubtotal / (quantity × conversionFactor)), consistent with
  // PurchaseInvoicesService.buildInvoicePostingRequest's existing use of
  // lineSubtotal as "the invoice cost" for PPV.
  invoiceUnitCost   Decimal? @db.Decimal(19, 4)
  invoiceCostAmount Decimal? @db.Decimal(19, 4)
  // MATCHED_INVOICE only, signed: invoiceCostAmount − receiptCostAmount.
  // Positive reverses part of an original unfavorable variance (Cr PPV);
  // negative reverses part of an original favorable variance (Dr PPV) — the
  // exact opposite-sign mirror of buildInvoicePostingRequest's own ppvTotal
  // convention. Tax-exclusive: Phase 3.5 explicitly defers Input Tax
  // reversal to a later phase (no taxAmount column here).
  ppvAmount         Decimal? @db.Decimal(19, 4)

  createdAt DateTime @default(now())

  purchaseReturnItem  PurchaseReturnItem   @relation(fields: [purchaseReturnItemId], references: [id], onDelete: Restrict)
  purchaseInvoiceItem PurchaseInvoiceItem? @relation(fields: [purchaseInvoiceItemId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([purchaseReturnItemId])
  @@index([purchaseInvoiceItemId])
  @@map("purchase_return_item_allocations")
}
