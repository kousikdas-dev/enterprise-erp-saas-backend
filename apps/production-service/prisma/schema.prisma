generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Infrastructure-only marker. Not a business entity. Do not expose via API.
model SchemaMeta {
  id        String   @id @default("foundation")
  appliedAt DateTime @default(now())

  @@map("_schema_meta")
}

enum BomStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

// Bill of Materials header. parentProductId is a logical reference to a
// Product owned by inventory-service — there is no cross-service FK; it is
// validated at write time via InventoryProductClient and snapshotted here
// (parentProductSku/parentProductName) so BOM history survives independent
// of later Product edits, mirroring PurchaseOrder's supplier-snapshot
// convention.
// bomQuantity + outputUnitOfMeasureId/outputUomCode/outputUomName define the
// manufacturing basis of the BOM (e.g. "100 KG of Cotton Yarn"), using the
// same snapshot pattern as BomItem's unitOfMeasureId/uomCode/uomName. All
// component quantities on this BOM are the material requirement for
// exactly bomQuantity of output — they are not re-scaled to any other basis.
model Bom {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @db.Uuid
  parentProductId       String    @db.Uuid
  parentProductSku      String
  parentProductName     String
  bomQuantity           Decimal   @db.Decimal(19, 6)
  outputUnitOfMeasureId String    @db.Uuid
  outputUomCode         String
  outputUomName         String
  version               Int
  status                BomStatus @default(DRAFT)
  effectiveFrom         DateTime?
  effectiveTo           DateTime?
  notes                 String?
  // Optionally scopes this BOM to exactly one variant of parentProductId
  // (inventory-service's Product.templateProductId must equal
  // parentProductId) — null means the BOM applies to all variants of the
  // product (or the product has no variants). Logical reference, validated
  // + snapshotted via InventoryProductClient the same way parentProductId
  // is, never a cross-service FK.
  productVariantId   String? @db.Uuid
  productVariantSku  String?
  productVariantName String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  items      BomItem[]
  operations BomOperation[]

  @@unique([tenantId, parentProductId, version])
  @@index([tenantId])
  @@index([tenantId, parentProductId])
  @@index([tenantId, parentProductId, status])
  @@map("boms")
}

// componentProductId is likewise a logical reference to an inventory-service
// Product — validated + snapshotted the same way as the Bom parent.
model BomItem {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @db.Uuid
  bomId                String   @db.Uuid
  componentProductId   String   @db.Uuid
  componentProductSku  String
  componentProductName String
  quantity             Decimal  @db.Decimal(19, 6)
  unitOfMeasureId      String   @db.Uuid
  uomCode              String
  uomName              String
  scrapPercentage      Decimal? @db.Decimal(5, 2)
  sequence             Int
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  bom Bom @relation(fields: [bomId], references: [id], onDelete: Cascade)

  @@unique([tenantId, bomId, componentProductId])
  @@index([tenantId])
  @@index([bomId])
  @@index([componentProductId])
  @@map("bom_items")
}

// Operation Master: defines WHAT manufacturing work is performed (e.g. CUT,
// WELD, MILL), independent of any industry or routing. Industry-neutral and
// user-defined — no operations are hard-coded. Referenced today by
// BomOperation (an ordered, sequence-only list of operations required to
// build a BOM's parent product — see below); will later also be referenced
// by Manufacturing Routing step records via operationId once Routing adds
// duration/work-centre assignment. isActive is deactivation-only (no
// cascading delete) so historical references keep resolving, mirroring the
// tenant-scoped code+name master pattern already used by
// inventory-service's UnitOfMeasure/Category.
model Operation {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  code        String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bomOperations BomOperation[]
  routingSteps  RoutingStep[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("operations")
}

// Links the Operation Master to a BOM: an ordered list of operations
// required to manufacture the BOM's parent product. Sequence only — no
// duration or Work Centre assignment yet; that belongs to the future
// Manufacturing Routing feature (see Operation/WorkCentre comments above),
// which this table is deliberately kept simple enough to be absorbed into
// once that exists. operationCode/operationName are snapshotted the same
// way BomItem snapshots its component product, so a BOM's operation list
// stays legible even if the Operation master is later renamed.
model BomOperation {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  bomId         String   @db.Uuid
  operationId   String   @db.Uuid
  operationCode String
  operationName String
  sequence      Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bom       Bom       @relation(fields: [bomId], references: [id], onDelete: Cascade)
  operation Operation @relation(fields: [operationId], references: [id], onDelete: Restrict)

  @@unique([tenantId, bomId, operationId])
  @@index([tenantId])
  @@index([bomId])
  @@index([operationId])
  @@map("bom_operations")
}

// Work Centre Master: defines WHERE manufacturing work is performed (e.g.
// CNC-01, SPIN-01), independent of any industry. Industry-neutral and
// user-defined — no work centres are hard-coded. Deliberately has no FK to
// Operation: the same work centre may perform different operations across
// different routings, so the relationship is many-to-many and only
// expressed later, per routing step, once Manufacturing Routing exists.
// Will later be referenced by Manufacturing Routing step records via
// workCentreId (no FK yet, since Routing doesn't exist); isActive is
// deactivation-only (no cascading delete) so historical routing references
// keep resolving once Routing is built, mirroring Operation's pattern.
model WorkCentre {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  code        String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  routingSteps RoutingStep[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("work_centres")
}

// Production Order lifecycle. Transitions are one-directional and enforced
// only through the dedicated plan/release/start/complete/cancel/close
// service methods — never via a generic status PATCH:
//
//   DRAFT -> PLANNED -> RELEASED -> IN_PROGRESS -> COMPLETED -> CLOSED
//     |         |           |
//     +---------+-----------+--> CANCELLED -> CLOSED
//
// COMPLETED is reachable only once Production Receipt exists (not this
// phase) — see ProductionOrdersService.complete(), which deliberately
// refuses the transition today rather than fabricate a completed quantity.
enum ProductionOrderStatus {
  DRAFT
  PLANNED
  RELEASED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  CLOSED
}

enum ProductionOrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// Production Order: the central manufacturing transaction. productId is a
// logical reference to an inventory-service Product (validated via
// InventoryProductClient, snapshotted as productSku/productName so history
// survives later Product edits — the same convention as Bom.parentProductId
// above). bomId/bomVersion reference this service's own Bom table directly
// (no cross-service call needed) and are re-validated, never blindly
// trusted, at create/plan/release time; once RELEASED they become immutable
// (see ProductionOrdersService.update()) so the authorized manufacturing
// plan cannot silently drift.
//
// routingId/routingVersion are reserved for the future Manufacturing
// Routing feature, which does not exist yet in this codebase. They are
// intentionally NOT accepted from the API today (there is nothing valid to
// validate them against) and are always persisted as null — the columns
// exist now purely so a later Routing integration can populate them without
// a breaking schema change.
//
// warehouseId is a logical, optional reference to an inventory-service
// Warehouse (validated via InventoryWarehouseClient when provided) — no
// warehouse data is duplicated here.
//
// RoutingStep snapshot is still not created in this phase (routingId/
// routingVersion above stay reserved/null). Component detail, however, IS
// now snapshotted per order via ProductionOrderItem (below): defaulted from
// the selected BOM's items (scaled to plannedQuantity) when not supplied,
// but independently editable per order from then on — deliberately
// deviating from the "derive on demand, don't copy" note that used to cover
// this field too, because Material Planning/Execution need a per-order
// material list that can diverge from the master BOM (substitutions, extra
// consumption) without ever mutating that BOM.
model ProductionOrder {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @db.Uuid
  orderNumber String

  productId   String @db.Uuid
  productSku  String
  productName String

  bomId      String @db.Uuid
  bomVersion Int

  routingId      String? @db.Uuid
  routingVersion Int?

  plannedQuantity Decimal @db.Decimal(19, 6)

  outputUnitOfMeasureId String @db.Uuid
  outputUomCode         String
  outputUomName         String

  orderDate        DateTime
  plannedStartDate DateTime?
  plannedEndDate   DateTime?

  warehouseId String? @db.Uuid

  priority ProductionOrderPriority @default(NORMAL)
  status   ProductionOrderStatus   @default(DRAFT)
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items      ProductionOrderItem[]
  workOrders WorkOrder[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, productId])
  @@map("production_orders")
}

// Per-order component list ("Components" tab). componentProductId is a
// logical reference to an inventory-service Product — validated +
// snapshotted the same way Bom.parentProductId/BomItem.componentProductId
// are. Defaults from the selected BOM's items (quantity scaled by
// plannedQuantity / bom.bomQuantity) when the client omits `items` on
// create; from then on the client owns the list and may add/remove/edit
// lines freely, same editable-table UX as BomItem.
model ProductionOrderItem {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @db.Uuid
  productionOrderId    String   @db.Uuid
  componentProductId   String   @db.Uuid
  componentProductSku  String
  componentProductName String
  quantity             Decimal  @db.Decimal(19, 6)
  unitOfMeasureId      String   @db.Uuid
  uomCode              String
  uomName              String
  sequence             Int
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productionOrderId, componentProductId])
  @@index([tenantId])
  @@index([productionOrderId])
  @@index([componentProductId])
  @@map("production_order_items")
}

// Work Order lifecycle. One-directional, enforced only through the
// dedicated start/block/unblock/complete/cancel service methods — never via
// a generic status PATCH, same convention as ProductionOrderStatus above:
//
//   PENDING -> IN_PROGRESS -> DONE
//     |            | ^
//     |            v |
//     |          BLOCKED
//     +--------------+--> CANCELLED
enum WorkOrderStatus {
  PENDING
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

// Work Order: a single schedulable shop-floor step against a Production
// Order, assigned to a Work Centre. There is no Manufacturing Routing
// feature yet (see ProductionOrder.routingId above), so Work Orders are not
// auto-generated from a BOM/routing template — they are added directly
// against a Production Order, each referencing an Operation and a Work
// Centre from this service's own master data (validated active + existing
// at create/update time, then snapshotted as code/name so history survives
// later master-data edits, the same convention used throughout this file).
model WorkOrder {
  id              String @id @default(uuid()) @db.Uuid
  tenantId        String @db.Uuid
  workOrderNumber String

  productionOrderId     String @db.Uuid
  productionOrderNumber String
  productId             String @db.Uuid
  productSku            String
  productName           String

  operationId   String @db.Uuid
  operationCode String
  operationName String

  workCentreId   String @db.Uuid
  workCentreCode String
  workCentreName String

  sequence               Int
  plannedDurationMinutes Int

  scheduledStartDate DateTime?
  scheduledEndDate   DateTime?

  status WorkOrderStatus @default(PENDING)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  @@unique([tenantId, workOrderNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, workCentreId])
  @@index([productionOrderId])
  @@map("work_orders")
}

enum RoutingStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

// Manufacturing Routing header: defines the ordered sequence of operations
// and work centres required to manufacture a product, independent of its
// Bill of Materials (BOM = materials, Routing = operations/work centres —
// orthogonal concerns, both attached directly to Product, never nested
// inside each other, mirroring how ProductionOrder already carries separate
// bomId/bomVersion and routingId/routingVersion column pairs). productId is
// a logical reference to an inventory-service Product — validated +
// snapshotted via InventoryProductClient the same way Bom.parentProductId
// is, never a cross-service FK.
//
// Versioning/lifecycle mirrors Bom exactly: version is a plain incrementing
// Int per (tenantId, productId); DRAFT is the only editable/deletable
// status; activate() deactivates every other ACTIVE routing for the same
// product in the same transaction (service-level "only one ACTIVE" — not a
// DB constraint, same trade-off Bom already accepts); new versions are
// always forked via a dedicated endpoint from any source status.
model Routing {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @db.Uuid
  productId   String        @db.Uuid
  productSku  String
  productName String

  name        String
  version     Int
  status      RoutingStatus @default(DRAFT)
  description String?
  effectiveFrom DateTime?
  effectiveTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps RoutingStep[]

  @@unique([tenantId, productId, version])
  @@index([tenantId])
  @@index([tenantId, productId])
  @@index([tenantId, productId, status])
  @@map("routings")
}

// A single routing step: WHAT operation, done WHERE (work centre), in what
// order, and its standard timing. operationId/workCentreId are validated
// against this service's own Operation/WorkCentre masters (must be active)
// and snapshotted (code/name) the same way BomOperation snapshots its
// operation, so a routing's step list stays legible even if the master is
// later renamed. The same Operation MAY repeat across steps (e.g.
// Weld -> Inspect -> Weld) — only `sequence` is unique per routing, not
// operationId; duplicate (operation, work centre) pairs are allowed.
//
// setupMinutes (fixed, one-time) + runMinutesPerUnit (scales with produced
// quantity) is the standard manufacturing time model; no scheduling
// algorithm consumes them yet (Phase 4+, not part of this delivery) — they
// exist so a future Work Order duration calculation has a documented
// formula to use: setupMinutes + ceil(runMinutesPerUnit * plannedQuantity).
model RoutingStep {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @db.Uuid
  routingId String @db.Uuid

  sequence Int

  operationId   String @db.Uuid
  operationCode String
  operationName String

  workCentreId   String @db.Uuid
  workCentreCode String
  workCentreName String

  setupMinutes      Int     @default(0)
  runMinutesPerUnit Decimal @default(0) @db.Decimal(19, 6)

  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  routing    Routing    @relation(fields: [routingId], references: [id], onDelete: Cascade)
  operation  Operation  @relation(fields: [operationId], references: [id], onDelete: Restrict)
  workCentre WorkCentre @relation(fields: [workCentreId], references: [id], onDelete: Restrict)

  @@unique([tenantId, routingId, sequence])
  @@index([tenantId])
  @@index([routingId])
  @@index([operationId])
  @@index([workCentreId])
  @@map("routing_steps")
}

// Unbuild Order lifecycle. DRAFT -> PROCESSING -> DONE is one-directional;
// DRAFT -> CANCELLED is the only other path. PROCESSING is a claim held by
// an in-flight complete() call (see UnbuildOrdersService.complete()) — it
// is reachable again from itself (a stale claim being reclaimed) and falls
// back to DRAFT only on a definite rejection from inventory-service (e.g.
// insufficient finished-goods stock), never on an ambiguous failure, where
// it is deliberately left PROCESSING so a retry can safely resume (the
// inventory-service posting this leads to is idempotent on this order's own
// id — see StockUnbuildPostingsService). DONE/CANCELLED are terminal: no
// update()/cancel() is accepted against them.
enum UnbuildOrderStatus {
  DRAFT
  PROCESSING
  DONE
  CANCELLED
}

// Unbuild Order: breaks down a finished product back into its BOM
// components, the inverse of a Production Order. productId/bomId mirror
// ProductionOrder's own conventions exactly — logical references to this
// service's own Bom table and to an inventory-service Product, validated
// and snapshotted the same way (productSku/productName never drift from
// what was true at create time). bomVersion is snapshotted so the order
// keeps referring to the exact BOM version it was created against even if
// a newer version is later activated.
//
// sourceProductionOrderId is optional and traceability-only — an Unbuild
// Order is valid for a finished product received through opening stock or
// any other source, not only one built by a Production Order in this
// system (see UnbuildOrdersService.create()). It is never read by
// complete() and never mutates the referenced Production Order or its Work
// Orders.
//
// quantity/unitOfMeasureId are the finished-good quantity being unbuilt,
// restricted to the product's own BASE unit at completion time (re-
// validated live against inventory-service, never trusted from this
// snapshot) — see UnbuildOrdersService.complete() and the design report's
// "base-unit-only" policy. Stock has no UOM dimension at all, so this
// restriction removes any need for quantity conversion anywhere in this
// flow.
//
// finishedGoodsMovementId is inventory-service's own StockMovement.id — a
// logical, cross-service reference (never an FK; inventory-service owns a
// separate database), populated only once status reaches DONE.
model UnbuildOrder {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @db.Uuid
  orderNumber String

  productId   String @db.Uuid
  productSku  String
  productName String

  bomId      String @db.Uuid
  bomVersion Int

  quantity        Decimal @db.Decimal(19, 6)
  unitOfMeasureId String  @db.Uuid
  uomCode         String
  uomName         String

  warehouseId String @db.Uuid

  sourceProductionOrderId     String? @db.Uuid
  sourceProductionOrderNumber String?

  status UnbuildOrderStatus @default(DRAFT)

  // Non-null only while status = PROCESSING. processingStartedAt drives the
  // staleness window a later complete() call uses to decide whether a live
  // claim can be reclaimed; processingToken is the fencing token that
  // decides whether THIS call's own eventual completion write is still the
  // one allowed to land (see UnbuildOrdersService.complete()) — a late
  // response from a superseded attempt must not be able to overwrite a
  // reclaiming attempt's result.
  processingStartedAt DateTime?
  processingToken     String?   @db.Uuid

  unbuildDate DateTime
  notes       String?

  completedAt             DateTime?
  completedBy             String?   @db.Uuid
  finishedGoodsMovementId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items UnbuildOrderItem[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, productId])
  @@map("unbuild_orders")
}

// Component return lines, snapshotted from the selected BOM's items at
// create time (scaled by quantity / bom.bomQuantity — the exact formula
// ProductionOrdersService.defaultItemsFromBom() already uses). The unique
// constraint mirrors BomItem's own [tenantId, bomId, componentProductId]
// constraint exactly: a BOM cannot list the same component twice, so this
// introduces no restriction beyond what the source BOM already enforces.
// stockMovementId is inventory-service's own StockMovement.id for this
// component's UNBUILD_RETURN leg, populated only once the order is DONE.
model UnbuildOrderItem {
  id                   String  @id @default(uuid()) @db.Uuid
  tenantId             String  @db.Uuid
  unbuildOrderId       String  @db.Uuid
  componentProductId   String  @db.Uuid
  componentProductSku  String
  componentProductName String
  quantity             Decimal @db.Decimal(19, 6)
  unitOfMeasureId      String  @db.Uuid
  uomCode              String
  uomName              String
  sequence             Int
  stockMovementId      String?

  unbuildOrder UnbuildOrder @relation(fields: [unbuildOrderId], references: [id], onDelete: Cascade)

  @@unique([tenantId, unbuildOrderId, componentProductId])
  @@index([tenantId])
  @@index([unbuildOrderId])
  @@map("unbuild_order_items")
}
