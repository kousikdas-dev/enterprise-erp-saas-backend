generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Infrastructure-only marker. Not a business entity. Do not expose via API.
model SchemaMeta {
  id        String   @id @default("foundation")
  appliedAt DateTime @default(now())

  @@map("_schema_meta")
}

enum StockMovementType {
  OPENING
  PURCHASE
  SALE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  // Phase 3.4 (Inventory Return Support) — stock coming back in against a
  // specific, identified original SALE movement (see
  // StockMovement.originalMovementId).
  SALE_RETURN
  // Phase 3.5 (Purchase Return) — stock going back out to a supplier against
  // a specific, identified original PURCHASE movement. Subtractive (mirrors
  // an issue), unlike SALE_RETURN's additive direction — see
  // StockReturnsService's RETURN_CONFIG.
  PURCHASE_RETURN
  // Phase 3.6 (Purchase Return reversal) — undoes a specific, identified
  // PURCHASE_RETURN movement: stock comes back in (additive, mirrors a
  // receipt), costed at that PURCHASE_RETURN movement's own unitCost
  // verbatim. The only StockMovementType other than Opening Stock's own
  // reversal to ever set StockMovement.reversesMovementId — see
  // StockReturnsService's RETURN_CONFIG.
  PURCHASE_RETURN_REVERSAL
}

// Opening Stock document lifecycle (Inventory Design v4, Phase B). DRAFT is
// freely editable; POSTED locks the lines and creates one OPENING
// StockMovement + OpeningStockActiveLine per line; REVERSED is terminal —
// there is no un-reversal, only a fresh corrective document.
enum OpeningStockStatus {
  DRAFT
  POSTED
  REVERSED
}

enum ProductType {
  GOODS
  SERVICE
  COMBO
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("categories")
}

model UnitOfMeasure {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  code      String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products     Product[]
  productUnits ProductUnit[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("units_of_measure")
}

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  code      String
  name      String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stocks    Stock[]
  movements StockMovement[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("warehouses")
}

model Product {
  id              String      @id @default(uuid()) @db.Uuid
  tenantId        String      @db.Uuid
  sku             String
  name            String
  description     String?
  categoryId      String      @db.Uuid
  unitOfMeasureId String      @db.Uuid
  sellingPrice    Decimal     @db.Decimal(19, 4)
  costPrice       Decimal     @db.Decimal(19, 4)
  isActive        Boolean     @default(true)
  productType     ProductType @default(GOODS)
  trackInventory  Boolean     @default(true)
  barcode         String?
  note            String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  category      Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unitOfMeasure UnitOfMeasure   @relation(fields: [unitOfMeasureId], references: [id], onDelete: Restrict)
  stocks        Stock[]
  movements     StockMovement[]
  productUnits  ProductUnit[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([categoryId])
  @@index([unitOfMeasureId])
  @@map("products")
}

model ProductUnit {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  productId        String   @db.Uuid
  unitOfMeasureId  String   @db.Uuid
  conversionFactor Decimal  @db.Decimal(19, 6)
  sellingPrice     Decimal  @db.Decimal(19, 4)
  costPrice        Decimal  @db.Decimal(19, 4)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitOfMeasure UnitOfMeasure @relation(fields: [unitOfMeasureId], references: [id], onDelete: Restrict)

  @@unique([tenantId, productId, unitOfMeasureId])
  @@index([tenantId])
  @@index([productId])
  @@index([unitOfMeasureId])
  @@map("product_units")
}

model Stock {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  productId   String   @db.Uuid
  warehouseId String   @db.Uuid
  quantity    Decimal  @db.Decimal(19, 6)
  // Inventory Valuation V1 (Phase 2) — Moving/Weighted Average. Current total
  // inventory value for this (tenant, product, warehouse); average unit cost
  // is always DERIVED as totalValue / quantity, never stored, so no
  // compounding rounding drift accumulates across many small updates.
  // Maintained atomically alongside quantity under the same row lock in
  // every service method that mutates this row (Opening Stock post/reverse,
  // stock receipts, stock issues) — never updated independently. Defaults to
  // 0 so every pre-Phase-2 code path (and any future caller that omits a
  // cost) leaves valuation untouched, exactly preserving prior behavior.
  totalValue  Decimal  @default(0) @db.Decimal(19, 4)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([tenantId, productId, warehouseId])
  @@index([tenantId])
  @@index([productId])
  @@index([warehouseId])
  @@map("stocks")
}

model StockMovement {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @db.Uuid
  productId     String            @db.Uuid
  warehouseId   String            @db.Uuid
  type          StockMovementType
  quantity      Decimal           @db.Decimal(19, 6)
  referenceType String?
  referenceId   String?           @db.Uuid
  reason        String?
  createdBy     String            @db.Uuid
  createdAt     DateTime          @default(now())

  // Inventory Design v4, Phase B (Opening Stock reversal). Set only on a
  // reversal movement, pointing back at the original movement it reverses;
  // never set on the original itself, which is retained unmodified forever.
  // The unique constraint is the DB-level backstop against ever creating a
  // second reversal for the same original movement (Postgres unique indexes
  // treat NULL as distinct from every other NULL, so ordinary movements are
  // unaffected).
  reversesMovementId String? @db.Uuid

  // Global, strictly-monotonic, gapless-enough ordering key used to
  // determine "subsequent stock-affecting activity" for a given
  // product+warehouse (Phase B reversal validation) — deliberately NOT
  // createdAt, whose millisecond precision cannot be trusted to break ties
  // deterministically under concurrent posting. For pre-existing rows this
  // is backfilled once, ordered by (createdAt ASC, id ASC) — id is only a
  // deterministic tie-breaker for rows sharing a createdAt value, not a
  // claim to have reconstructed their true real-world order. See the
  // migration for the exact backfill procedure.
  sequenceNumber BigInt @default(autoincrement())

  // Inventory Valuation V1 (Phase 2) — Moving/Weighted Average. Nullable:
  // only movements that carry cost information under this phase (OPENING,
  // PURCHASE receipts that supplied a cost, SALE issues, and their
  // reversals) populate these; legacy pre-Phase-2 rows and cost-less callers
  // (e.g. Stock Adjustment, or a receipt that omits unitCost for backward
  // compatibility) leave both null. unitCost is per BASE unit; totalCost is
  // the exact value this movement applied to Stock.totalValue (always
  // recorded as a snapshot at the time of the movement — an issue's unitCost
  // is never re-derived later from a since-changed Stock average).
  unitCost  Decimal? @db.Decimal(19, 4)
  totalCost Decimal? @db.Decimal(19, 4)

  // Phase 3.4 (Inventory Return Support) — soft reference (no @relation,
  // deliberately mirroring reversesMovementId's own bare-column style),
  // set only on a SALE_RETURN movement, pointing at the specific original
  // SALE movement it returns against. This is the AUTHORITATIVE selector
  // for "which movement is this returning against" — never resolved by
  // (referenceType, referenceId, productId) lookup. Deliberately NOT
  // reversesMovementId: that column is unique per original movement
  // (Opening Stock's "at most one reversal ever" rule) and would wrongly
  // forbid a second partial return against the same sale.
  originalMovementId String? @db.Uuid

  // Running total of quantity already returned AGAINST this movement —
  // meaningful on SALE and PURCHASE rows (returns) and, since Phase 3.6, on
  // PURCHASE_RETURN rows too (a reversal is itself a "return against" the
  // PURCHASE_RETURN movement, using this same generic field/check). Stays 0
  // on SALE_RETURN and PURCHASE_RETURN_REVERSAL rows — neither is ever
  // itself returned/reversed against. Enforced under a FOR UPDATE lock on
  // this row: returnedQuantity + returnQty <= quantity, atomically, so
  // concurrent partial returns/reversals against the same original movement
  // can never overshoot.
  returnedQuantity Decimal @default(0) @db.Decimal(19, 6)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([reversesMovementId])
  @@unique([sequenceNumber])
  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([productId])
  @@index([warehouseId])
  @@index([tenantId, productId, warehouseId, sequenceNumber])
  @@index([originalMovementId])
  @@map("stock_movements")
}

// Opening Stock document header (Inventory Design v4, Phase B). A distinct
// business document — never a plain Stock Adjustment — because opening
// balances need their own lifecycle (DRAFT review before commit, REVERSED
// for corrections), multi-line/multi-warehouse atomicity, and a real
// audit/reference trail back from the StockMovement it creates.
model OpeningStock {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String             @db.Uuid
  documentNumber String
  status         OpeningStockStatus @default(DRAFT)
  effectiveDate  DateTime
  postedAt       DateTime?
  postedBy       String?            @db.Uuid
  reversedAt     DateTime?
  reversedBy     String?            @db.Uuid
  reversalReason String?
  notes          String?
  createdBy      String             @db.Uuid
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  lines OpeningStockLine[]

  @@unique([tenantId, documentNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("opening_stocks")
}

model OpeningStockLine {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  openingStockId   String   @db.Uuid
  productId        String   @db.Uuid
  warehouseId      String   @db.Uuid
  quantity         Decimal  @db.Decimal(19, 6)
  unitOfMeasureId  String   @db.Uuid
  uomCode          String
  uomName          String
  // Resolved once when the line is added to the (DRAFT) document and never
  // recomputed from current ProductUnit data afterward — post() always
  // reuses these persisted values, exactly mirroring GoodsReceiptItem /
  // ShipmentItem baseQuantity (Phase B §8).
  conversionFactor Decimal  @db.Decimal(19, 6)
  baseQuantity     Decimal  @db.Decimal(19, 6)
  // Inventory Valuation V1 (Phase 2) — optional unit cost per BASE unit for
  // this line, snapshotted onto the OPENING StockMovement's unitCost/
  // totalCost at post() time. Nullable: an opening line without a cost
  // contributes 0 to Stock.totalValue, exactly preserving pre-Phase-2
  // behavior for any caller that doesn't supply one.
  unitCost         Decimal? @db.Decimal(19, 4)
  stockMovementId  String?  @db.Uuid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  openingStock OpeningStock @relation(fields: [openingStockId], references: [id], onDelete: Cascade)

  @@unique([tenantId, openingStockId, productId, warehouseId])
  @@index([tenantId])
  @@index([openingStockId])
  @@index([productId])
  @@index([warehouseId])
  @@map("opening_stock_lines")
}

/// Duplicate-opening guard (Inventory Design v4, Phase B). Exactly one row
/// exists per (tenantId, productId, warehouseId) while an OpeningStock
/// covering that combination is POSTED and not yet REVERSED — inserted
/// atomically inside the posting transaction (so the unique constraint
/// itself, not application logic, is what makes "no duplicate active
/// opening" both correct and concurrency-safe) and deleted inside the
/// reversal transaction, freeing that product+warehouse for a future
/// corrective document.
model OpeningStockActiveLine {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  productId      String   @db.Uuid
  warehouseId    String   @db.Uuid
  openingStockId String   @db.Uuid
  createdAt      DateTime @default(now())

  @@unique([tenantId, productId, warehouseId])
  @@index([openingStockId])
  @@map("opening_stock_active_lines")
}

/// Idempotency ledger for cross-service purchase goods receipts.
model StockReceiptApplication {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  referenceType String
  referenceId   String   @db.Uuid
  warehouseId   String   @db.Uuid
  payloadHash   String
  createdAt     DateTime @default(now())

  @@unique([tenantId, referenceType, referenceId])
  @@index([tenantId])
  @@map("stock_receipt_applications")
}
