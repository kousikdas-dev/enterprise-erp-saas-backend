# Local development defaults. Copy to .env and replace secrets before running.
# Never commit .env.

NODE_ENV=development
LOG_LEVEL=info

# --- Local Postgres (docker compose) ---
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_local_only
# Host port published by Compose. NestJS/Prisma on Windows use localhost:POSTGRES_PORT.
# Containers still connect to postgres:5432 (see docker-compose.yml overrides).
POSTGRES_PORT=15432

# --- RabbitMQ ---
RABBITMQ_USER=erp
RABBITMQ_PASSWORD=erp_local_only
# Host AMQP port. Compose maps this to container 5672; containers use rabbitmq:5672.
RABBITMQ_PORT=25672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://erp:erp_local_only@localhost:25672

# --- JWT (replace with long random values) ---
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Service-to-service only. Inventory sends this to Identity for POST /api/v1/internal/audit.
# Never send this header from a browser or through the API Gateway.
INTERNAL_SERVICE_SECRET=replace-with-a-long-random-internal-service-secret

# Shared local file: PORT/SERVICE_NAME apply to the API Gateway.
# Identity binds 3001 (see apps/identity-service/src/main.ts). Compose also uses PORT: 3001.
SERVICE_NAME=api-gateway
PORT=3000
# Gateway and Inventory (audit client) both call Identity at this URL.
IDENTITY_SERVICE_URL=http://localhost:3001
SALES_SERVICE_URL=http://localhost:3002
INVENTORY_SERVICE_URL=http://localhost:3003
ACCOUNTING_SERVICE_URL=http://localhost:3004

# Host-side DATABASE_URL for `npm run start:*` and Prisma CLI (this machine).
# Docker Compose ignores this value inside service containers and sets
# postgresql://...@postgres:5432/<service_db> instead.
# identity:   postgresql://erp:erp_local_only@localhost:15432/identity_db?schema=public
# sales:      postgresql://erp:erp_local_only@localhost:15432/sales_db?schema=public
# inventory:  postgresql://erp:erp_local_only@localhost:15432/inventory_db?schema=public
# accounting: postgresql://erp:erp_local_only@localhost:15432/accounting_db?schema=public
DATABASE_URL=postgresql://erp:erp_local_only@localhost:15432/identity_db?schema=public
RABBITMQ_QUEUE=identity.events

# Development Identity seed only (`npm run prisma:seed:identity`). Never used in production.
DEV_ADMIN_PASSWORD=DevPassword123!
