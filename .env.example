# Local development defaults. Copy to .env and replace secrets before running.
# Never commit .env.

NODE_ENV=development
LOG_LEVEL=info

# --- Local Postgres (docker compose) ---
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_local_only
POSTGRES_PORT=5432

# --- RabbitMQ ---
RABBITMQ_USER=erp
RABBITMQ_PASSWORD=erp_local_only
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://erp:erp_local_only@localhost:5672

# --- JWT (replace with long random values) ---
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- API Gateway ---
SERVICE_NAME=api-gateway
PORT=3000
IDENTITY_SERVICE_URL=http://localhost:3001
SALES_SERVICE_URL=http://localhost:3002
INVENTORY_SERVICE_URL=http://localhost:3003
ACCOUNTING_SERVICE_URL=http://localhost:3004

# Per-service DATABASE_URL values (override when starting a specific service)
# identity:  postgresql://erp:erp_local_only@localhost:5432/identity_db?schema=public
# sales:     postgresql://erp:erp_local_only@localhost:5432/sales_db?schema=public
# inventory: postgresql://erp:erp_local_only@localhost:5432/inventory_db?schema=public
# accounting:postgresql://erp:erp_local_only@localhost:5432/accounting_db?schema=public
DATABASE_URL=postgresql://erp:erp_local_only@localhost:5432/identity_db?schema=public
RABBITMQ_QUEUE=identity.events
