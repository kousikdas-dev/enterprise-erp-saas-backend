# Local development defaults. Copy to .env and replace secrets before running.
# Never commit .env.

NODE_ENV=development
LOG_LEVEL=info

# --- Local Postgres (docker compose) ---
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_local_only
# Host port published by Compose. NestJS/Prisma on Windows use localhost:POSTGRES_PORT.
# Containers still connect to postgres:5432 (see docker-compose.yml overrides).
POSTGRES_PORT=15432

# --- RabbitMQ ---
RABBITMQ_USER=erp
RABBITMQ_PASSWORD=erp_local_only
# Host AMQP port. Compose maps this to container 5672; containers use rabbitmq:5672.
RABBITMQ_PORT=25672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://erp:erp_local_only@localhost:25672

# --- JWT (replace with unique random values; access secret must be >= 32 chars) ---
# Production (Compose NODE_ENV=production) rejects short or known-placeholder values.
JWT_ACCESS_SECRET=change-me-use-a-unique-jwt-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-use-a-unique-jwt-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Service-to-service only. Inventory sends this to Identity for POST /api/v1/internal/audit.
# Never send this header from a browser or through the API Gateway.
INTERNAL_SERVICE_SECRET=change-me-use-a-unique-internal-service-secret-min-32

# Shared local file: PORT/SERVICE_NAME apply to the API Gateway.
# Identity binds 3001 (see apps/identity-service/src/main.ts). Compose also uses PORT: 3001.
SERVICE_NAME=api-gateway
PORT=3000
# Gateway and Inventory (audit client) both call Identity at this URL.
IDENTITY_SERVICE_URL=http://localhost:3001
SALES_SERVICE_URL=http://localhost:3002
INVENTORY_SERVICE_URL=http://localhost:3003
ACCOUNTING_SERVICE_URL=http://localhost:3004
PURCHASE_SERVICE_URL=http://localhost:3005
PRODUCTION_SERVICE_URL=http://localhost:3007

# Explicit, per-service host-side database URLs.
# - `npm run prisma:migrate:*` and `npm run prisma:seed:*` go through
#   scripts/run-with-db.js, which reads exactly one of these (by service
#   name) and sets DATABASE_URL for that command only.
# - `npm run start:*` / `start:prod:*` resolve the same way, via each
#   service's own main.ts calling resolveServiceDatabaseUrl('<service>')
#   (libs/common/src/config/resolve-service-database-url.ts) before
#   NestFactory/Prisma ever reads DATABASE_URL. The explicit key here
#   always wins over the legacy DATABASE_URL below when both are set.
# Either way, a command/service can never silently run against the wrong
# database just because some OTHER key happened to be edited last.
# `prisma:generate:*` needs none of these (confirmed: `prisma generate`
# never opens a database connection) and is left unwrapped.
IDENTITY_DATABASE_URL=postgresql://erp:erp_local_only@localhost:15432/identity_db?schema=public
SALES_DATABASE_URL=postgresql://erp:erp_local_only@localhost:15432/sales_db?schema=public
INVENTORY_DATABASE_URL=postgresql://erp:erp_local_only@localhost:15432/inventory_db?schema=public
ACCOUNTING_DATABASE_URL=postgresql://erp:erp_local_only@localhost:15432/accounting_db?schema=public
PURCHASE_DATABASE_URL=postgresql://erp:erp_local_only@localhost:15432/purchase_db?schema=public
MASTER_DATA_DATABASE_URL=postgresql://erp:erp_local_only@localhost:15432/master_data_db?schema=public
PRODUCTION_DATABASE_URL=postgresql://erp:erp_local_only@localhost:15432/production_db?schema=public

# Legacy, ambiguous host-side DATABASE_URL. No longer read directly by
# anything that goes through resolveServiceDatabaseUrl() or
# scripts/run-with-db.js (both now prefer the explicit *_DATABASE_URL keys
# above). Still used as-is by Docker Compose's own injected value inside
# each container (unaffected — containers never set a *_DATABASE_URL), and
# kept here as the final fallback if a *_DATABASE_URL key is ever missing.
# Kept for now (not removed in this change).
DATABASE_URL=postgresql://erp:erp_local_only@localhost:15432/identity_db?schema=public
RABBITMQ_QUEUE=identity.events

# Development Identity seed only (`npm run prisma:seed:identity`). Never used in production.
DEV_ADMIN_PASSWORD=DevPassword123!
