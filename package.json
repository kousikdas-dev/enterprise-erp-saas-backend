{
  "name": "erp-backend",
  "version": "0.1.0",
  "description": "Enterprise ERP/SaaS backend — NestJS microservices foundation",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "npm run build:gateway && npm run build:identity && npm run build:sales && npm run build:inventory && npm run build:accounting && npm run build:purchase && npm run build:master-data",
    "build:gateway": "nest build api-gateway",
    "build:identity": "nest build identity-service",
    "build:sales": "nest build sales-service",
    "build:inventory": "nest build inventory-service",
    "build:accounting": "nest build accounting-service",
    "build:purchase": "nest build purchase-service",
    "build:master-data": "nest build master-data-service",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start api-gateway",
    "start:gateway": "nest start api-gateway --watch",
    "start:identity": "nest start identity-service --watch",
    "start:sales": "nest start sales-service --watch",
    "start:inventory": "nest start inventory-service --watch",
    "start:accounting": "nest start accounting-service --watch",
    "start:purchase": "nest start purchase-service --watch",
    "start:master-data": "nest start master-data-service --watch",
    "start:debug": "nest start api-gateway --debug --watch",
    "start:prod:gateway": "node dist/apps/api-gateway/main.js",
    "start:prod:identity": "node dist/apps/identity-service/main.js",
    "start:prod:sales": "node dist/apps/sales-service/main.js",
    "start:prod:inventory": "node dist/apps/inventory-service/main.js",
    "start:prod:accounting": "node dist/apps/accounting-service/main.js",
    "start:prod:purchase": "node dist/apps/purchase-service/main.js",
    "start:prod:master-data": "node dist/apps/master-data-service/main.js",
    "lint": "eslint \"{apps,libs,test}/**/*.ts\" --fix",
    "postinstall": "npm run prisma:generate",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "prisma:generate": "npm run prisma:generate:identity && npm run prisma:generate:sales && npm run prisma:generate:inventory && npm run prisma:generate:accounting && npm run prisma:generate:purchase && npm run prisma:generate:master-data",
    "prisma:generate:identity": "prisma generate --schema=apps/identity-service/prisma/schema.prisma",
    "prisma:generate:sales": "prisma generate --schema=apps/sales-service/prisma/schema.prisma",
    "prisma:generate:inventory": "prisma generate --schema=apps/inventory-service/prisma/schema.prisma",
    "prisma:generate:accounting": "prisma generate --schema=apps/accounting-service/prisma/schema.prisma",
    "prisma:generate:purchase": "prisma generate --schema=apps/purchase-service/prisma/schema.prisma",
    "prisma:generate:master-data": "prisma generate --schema=apps/master-data-service/prisma/schema.prisma",
    "prisma:migrate:identity": "prisma migrate dev --schema=apps/identity-service/prisma/schema.prisma",
    "prisma:migrate:sales": "prisma migrate dev --schema=apps/sales-service/prisma/schema.prisma",
    "prisma:migrate:inventory": "prisma migrate dev --schema=apps/inventory-service/prisma/schema.prisma",
    "prisma:migrate:accounting": "prisma migrate dev --schema=apps/accounting-service/prisma/schema.prisma",
    "prisma:migrate:purchase": "prisma migrate dev --schema=apps/purchase-service/prisma/schema.prisma",
    "prisma:migrate:master-data": "prisma migrate dev --schema=apps/master-data-service/prisma/schema.prisma",
    "prisma:seed:identity": "ts-node --transpile-only apps/identity-service/prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.2.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.16.3",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^0.10.8",
    "axios": "^1.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "nestjs-pino": "^4.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^6.16.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "setupFiles": [
      "<rootDir>/test/setup-env.ts"
    ],
    "moduleNameMapper": {
      "^@app/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^@app/messaging(|/.*)$": "<rootDir>/libs/messaging/src/$1"
    }
  }
}
